---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ArticleArt from '../../components/ArticleArt.astro';
import { useTranslations } from '../../i18n/ui';
import { path } from '../../i18n/utils';
import { sectionColor, sectionIcon } from '../../i18n/sectionTheme';
import { HTML_LANG, type Language } from '../../i18n/languages';
import { getSections, getArticles, getFaqItems, renderMarkdown, getArticleText, getFaqText, isBlockedInCountry } from '../../lib/sanity';

const { lang } = Astro.params as { lang: Language };
const t = useTranslations(lang);
const country = Astro.request.headers.get('cf-ipcountry') ?? '';

const [sections, allArticles, allFaq] = await Promise.all([
  getSections(),
  getArticles(),
  getFaqItems(),
]);

const articles = allArticles.filter((a) => !isBlockedInCountry(a.blockedIn, country));
const faqItems = allFaq.filter((f) => !isBlockedInCountry(f.blockedIn, country));

const latestArticles = articles.slice(0, 6);
const [featuredArticle, ...restArticles] = latestArticles;

const featuredTitle = featuredArticle ? getArticleText(featuredArticle, 'title', lang) : '';
const featuredDescription = featuredArticle ? getArticleText(featuredArticle, 'description', lang) : '';
const featuredColor = sectionColor(featuredArticle?.section ?? '');
const featuredDate = featuredArticle
  ? new Intl.DateTimeFormat(HTML_LANG[lang], { year: 'numeric', month: 'long', day: 'numeric' }).format(new Date(featuredArticle.pubDate))
  : '';
const featuredSection = sections.find((s) => s.id === featuredArticle?.section);

const faqViews = faqItems.slice(0, 4).map((item) => ({
  question: getFaqText(item, 'question', lang),
  answerHtml: renderMarkdown(getFaqText(item, 'answer', lang)),
}));
---

<BaseLayout lang={lang} title={t.hero.title} description={t.hero.subtitle} currentPath="">
  <section class="hero">
    <div class="container">
      <div class="badge">{t.hero.badge}</div>
      <h1>{t.hero.title}</h1>
      <p class="hero-sub">{t.hero.subtitle}</p>
    </div>
  </section>

  <section class="section" id="sections">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="section-title">{t.home.sectionsTitle}</h2>
          <p class="section-sub">{t.home.sectionsSubtitle}</p>
        </div>
      </div>
      <div class="niche-grid">
        {sections.map((section) => (
          <a href={path(lang, section.id)} class="niche-card" style={`--card-color: ${sectionColor(section.id)}`}>
            <span class="niche-icon">{section.icon}</span>
            <h3>{t.sections[section.id as keyof typeof t.sections] ?? section.title}</h3>
            <p>{t.sectionDescriptions[section.id as keyof typeof t.sectionDescriptions] ?? section.description}</p>
            <span class="niche-link">{t.common.allArticles} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--dark" id="articles">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="section-title">{t.home.latestTitle}</h2>
          <p class="section-sub">{t.home.latestSubtitle}</p>
        </div>
      </div>
      <div class="feed">
        {featuredArticle && (
          <a href={path(lang, 'articles', featuredArticle.id)} class="feed-feature" style={`--card-color: ${featuredColor}`}>
            <div class="feed-feature-visual">
              <ArticleArt seed={featuredArticle.id} color={featuredColor} icon={featuredSection?.icon ?? sectionIcon(featuredArticle.section)} />
            </div>
            <div class="feed-feature-body">
              <span class="article-tag">{t.sections[featuredArticle.section as keyof typeof t.sections] ?? featuredArticle.section}</span>
              <h3>{featuredTitle}</h3>
              <p>{featuredDescription}</p>
              <div class="article-meta">
                <span>{featuredDate}</span>
                <span class="dot">{featuredArticle.readingTime} {t.article.readingTime}</span>
              </div>
            </div>
          </a>
        )}
        <div class="feed-grid">
          {restArticles.map((article) => <ArticleCard lang={lang} article={article} />)}
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="section-title">{t.home.faqTitle}</h2>
          <p class="section-sub">{t.home.faqSubtitle}</p>
        </div>
        <a href={path(lang, 'faq')} class="view-all">{t.home.viewAll} →</a>
      </div>
      <div class="faq-list">
        {faqViews.map(({ question, answerHtml }) => (
          <details class="faq-item">
            <summary>{question}</summary>
            <div class="faq-body prose" set:html={answerHtml} />
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
