---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { useTranslations } from '../../i18n/ui';
import { isLanguage, isIndexable, type Language } from '../../i18n/languages';
import { path } from '../../i18n/utils';
import { TOOLS } from '../../data/tools';
import { getSections, getIndexLists, isBlockedInCountry, markContentUnavailable, DATA_ERROR_COPY, type SanityArticleCard } from '../../lib/sanity';

const { lang } = Astro.params as { lang: Language };

// Подстраховка: в SSR [lang] ловит любой первый сегмент, поэтому без проверки
// /foo/ отдавал бы 200 с русской главной — soft-404 и дубль контента.
if (!isLanguage(lang)) return Astro.rewrite('/404');

const t = useTranslations(lang);
const country = Astro.request.headers.get('cf-ipcountry') ?? '';

const [sectionsResult, listsResult] = await Promise.all([
  getSections(),
  getIndexLists(lang),
]);

// На индексируемой локали карточка без перевода — это русский заголовок на
// странице другого языка и ссылка на статью, которая сама ответит noindex.
// Пять noindex-локалей фолбэк оставляют: там он и есть содержимое указателя.
const visible = (a: SanityArticleCard) =>
  !isBlockedInCountry(a.blockedIn, country) && (!isIndexable(lang) || a.hasTranslation !== false);
const guides = listsResult.data.guides.filter(visible);
const news = listsResult.data.news.filter(visible);

// Сбой CMS не кладёт главную: она рендерится с пустым указателем и явным
// сообщением. Плашка обязательна — иначе «в CMS пусто» и «CMS недоступна»
// выглядят одинаково. Статус 503 ставим только когда пропал основной контент
// (списки статей); упавшая навигация по разделам страницу не обессмысливает.
const dataFailed = sectionsResult.failed || listsResult.failed;
const errorCopy = DATA_ERROR_COPY[lang];
if (listsResult.failed) markContentUnavailable(Astro.response);
---

{/*
  <title> главной набирается из tagline, а не из hero.title: заголовок героя —
  это H1 и он длиннее лимита сниппета (63/78 симв. с префиксом «Ve7as — »),
  а tagline укладывается в 60 на обоих индексируемых языках.
*/}
<BaseLayout lang={lang} title={t.site.tagline} description={t.hero.subtitle} currentPath="">

  {/*
    Главная — указатель, а не витрина. Сетка карточек продаёт, список
    объясняет; для редакции, которая заявляет «ноль партнёрских ссылок»,
    второе честнее.

    Списков два, и разборы стоят выше новостей. Конвейер выпускает по новости
    в день, и в единой хронологической ленте все 24 места занимали новости:
    на разборы — то, ради чего портал существует, — с главной не вела ни одна
    ссылка. Внутри каждого списка порядок хронологический, без выделенного
    главного материала.
  */}
  <header class="page-head">
    <div class="container">
      <h1>{t.hero.title}</h1>
      <p class="lede">{t.hero.subtitle}</p>
    </div>
  </header>

  {(dataFailed || (guides.length === 0 && news.length === 0)) && (
    <section class="section">
      <div class="container">
        {dataFailed ? (
          <p class="notice notice--error">
            <strong>{errorCopy.title}.</strong> {errorCopy.body}
          </p>
        ) : (
          <p class="section-sub">—</p>
        )}
      </div>
    </section>
  )}

  {guides.length > 0 && (
    <section class="section">
      <div class="container">
        <h2 class="nf-sections-title">{t.index.guides}</h2>
        <div class="idx">
          {guides.map((article) => <ArticleCard lang={lang} article={article} />)}
        </div>
      </div>
    </section>
  )}

  {news.length > 0 && (
    <section class="section">
      <div class="container">
        <h2 class="nf-sections-title">{t.index.news}</h2>
        <div class="idx">
          {news.map((article) => <ArticleCard lang={lang} article={article} />)}
        </div>
      </div>
    </section>
  )}

  {/*
    Калькуляторы — с главной, каждый своей ссылкой.
    Раньше на весь указатель инструментов вела одна ссылка в футере, а на сами
    калькуляторы — ни одной: Search Console держала все десять их адресов
    (en + es) в статусе «обнаружена, не проиндексирована» с пустым полем
    «последнее сканирование», то есть робот о них знал и не приходил. Для
    молодого домена с нулём внешних ссылок глубина и число внутренних ссылок —
    единственный рычаг, которым мы вообще можем двигать обход.

    Блок под списком статей, а не над ним: главная остаётся указателем
    материалов, инструменты — то, что предлагается дальше.
  */}
  <section class="section">
    <div class="container">
      <h2 class="nf-sections-title">{t.footer.tools}</h2>
      <div class="nf-sections">
        {TOOLS.map((tool) => (
          <a href={path(lang, ...tool.segments)} class="nf-section">
            <strong>{tool.name[lang]}</strong>
            <span class="section-sub">{tool.blurb[lang]}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
