---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { useTranslations } from '../../../i18n/ui';
import { isLanguage, isIndexable, type Language } from '../../../i18n/languages';
import { path } from '../../../i18n/utils';
import { type SectionId } from '../../../i18n/sections';
import { toolsForSection } from '../../../data/tools';
import { getSections, getIndexLists, isBlockedInCountry, markContentUnavailable, DATA_ERROR_COPY, renderMarkdown, type SanityArticleCard } from '../../../lib/sanity';
import { breadcrumbs } from '../../../lib/schema';

const { lang, section: sectionId } = Astro.params as { lang: Language; section: string };

// Подстраховка: в SSR [lang] ловит любой первый сегмент, поэтому без проверки
// /foo/casino-slots/ отдавал бы 200 с русским контентом (soft-404).
if (!isLanguage(lang)) return Astro.rewrite('/404');

const t = useTranslations(lang);
const country = Astro.request.headers.get('cf-ipcountry') ?? '';

// Список разделов и статьи раздела — одним заходом. Фильтр по разделу теперь
// в GROQ: раньше страница забирала все статьи портала и отсеивала чужие в JS.
const [sectionsResult, listsResult] = await Promise.all([
  getSections({ bodyLang: lang }),
  getIndexLists(lang, { section: sectionId }),
]);

// Порядок проверок важен. Если список разделов не загрузился, «раздел не
// найден» — неправда: мы просто не знаем, существует он или нет. 404 здесь
// выбил бы живой URL из индекса из-за нашего же сбоя, поэтому 503.
if (sectionsResult.failed) {
  markContentUnavailable(Astro.response);
}

const section = sectionsResult.data.find((s) => s.id === sectionId);
// Несуществующий раздел — честный 404, а не редирект на главную:
// редирект Google трактует как soft-404 и держит URL в индексе.
if (!section && !sectionsResult.failed) return Astro.rewrite('/404');

// id раздела приходит из URL и из CMS, поэтому это `string`: приводим к
// `SectionId` только для доступа в словарь и подстраховываемся фолбэком.
const knownId = (section?.id ?? sectionId) as SectionId;
const sectionTitle = t.sections[knownId] ?? section?.title ?? sectionId;
const sectionDesc = t.sectionDescriptions[knownId] ?? section?.description ?? '';

// На индексируемой локали карточка без перевода — это русский заголовок на
// странице другого языка и ссылка на статью, которая сама ответит noindex.
// Пять noindex-локалей фолбэк оставляют: там он и есть содержимое хаба.
const visible = (a: SanityArticleCard) =>
  !isBlockedInCountry(a.blockedIn, country) && (!isIndexable(lang) || a.hasTranslation !== false);
const guides = listsResult.data.guides.filter(visible);
const news = listsResult.data.news.filter(visible);

// Текст хаба. Пустой body — норма (хаб ещё не наполнен), рендерим просто
// список; это не то же самое, что сбой CMS, который обрабатывается выше.
const hubHtml = section?.body ? renderMarkdown(section.body) : '';
const hubIsFallback = Boolean(section?.body) && section?.hasTranslation === false;

// Описательный <title> включается сам, когда у хаба появляется текст на языке
// страницы. Пока текста нет (или он русский фолбэк), остаётся голое название
// рубрики: заголовок в выдаче не должен обещать разбор, которого здесь нет.
// <h1>, крошки и навигация всегда на sectionTitle.
const pageTitle = hubHtml && !hubIsFallback ? (t.sectionSeoTitles?.[knownId] ?? sectionTitle) : sectionTitle;

// Разметка повторяет видимую цепочку над <h1>. При сбое CMS раздела нет —
// размечать крошки для страницы, отдающей 503, нечем и незачем.
const schema = section
  ? [
      breadcrumbs([
        { name: t.nav.home, url: new URL(path(lang), Astro.site).toString() },
        { name: sectionTitle, url: new URL(path(lang, sectionId), Astro.site).toString() },
      ]),
    ]
  : [];

// Списки статей и есть содержимое страницы: их пропажа — тоже 503.
const dataFailed = sectionsResult.failed || listsResult.failed;
const errorCopy = DATA_ERROR_COPY[lang];
if (listsResult.failed) markContentUnavailable(Astro.response);

// Калькуляторы этой рубрики. Тематическая ссылка с хаба — второй вход для
// краулера к страницам, которые он до сих пор ни разу не сканировал, и
// заодно единственное место, где читатель рубрики видит их в контексте.
const sectionTools = toolsForSection(knownId);

---

<BaseLayout lang={lang} title={pageTitle} description={sectionDesc} currentPath={sectionId} schema={schema}>
  <header class="page-head">
    <div class="container">
      <nav class="breadcrumb" aria-label={t.nav.breadcrumb}>
        <a href={path(lang)}>{t.nav.home}</a>
        <span class="sep">/</span>
        <span>{sectionTitle}</span>
      </nav>
      <h1>{sectionTitle}</h1>
      <p class="lede">{sectionDesc}</p>
    </div>
  </header>

  {/*
    Прочерк — это «в разделе пока пусто». При сбое вместо него стоит плашка,
    так что пустота от сбоя и пустота по сути читаются по-разному.
  */}
  {(dataFailed || (guides.length === 0 && news.length === 0)) && (
    <section class="section">
      <div class="container">
        {dataFailed ? (
          <p class="notice notice--error">
            <strong>{errorCopy.title}.</strong> {errorCopy.body}
          </p>
        ) : (
          <p class="section-sub">—</p>
        )}
      </div>
    </section>
  )}

  {/*
    Разборы выше новостей: новость в рубрике появляется каждый день, и в общей
    хронологической ленте разборы уходили на дно списка, а затем и за его лимит.
    Хаб без новостей показывает один список — пустой заголовок не рендерим.
  */}
  {guides.length > 0 && (
    <section class="section">
      <div class="container">
        <h2 class="nf-sections-title">{t.index.guides}</h2>
        <div class="idx">
          {guides.map((article) => <ArticleCard lang={lang} article={article} />)}
        </div>
      </div>
    </section>
  )}

  {news.length > 0 && (
    <section class="section">
      <div class="container">
        <h2 class="nf-sections-title">{t.index.news}</h2>
        <div class="idx">
          {news.map((article) => <ArticleCard lang={lang} article={article} />)}
        </div>
      </div>
    </section>
  )}

  {sectionTools.length > 0 && (
    <section class="section">
      <div class="container">
        <h2 class="nf-sections-title">{t.footer.tools}</h2>
        <div class="nf-sections">
          {sectionTools.map((tool) => (
            <a href={path(lang, ...tool.segments)} class="nf-section">
              <strong>{tool.name[lang]}</strong>
              <span class="section-sub">{tool.blurb[lang]}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {/*
    Текст хаба — ПОД списком: указатель в этой теме главный, читатель приходит
    за материалами, а объясняющий текст раскрывает рубрику тем, кто дошёл до
    конца, и даёт хабу ранжироваться по категорийному запросу.
  */}
  {hubHtml && (
    <section class="section">
      <div class="container">
        {hubIsFallback && <p class="notice">{t.article.translationNotice}</p>}
        <div class="prose hub-text" set:html={hubHtml} />
      </div>
    </section>
  )}
</BaseLayout>
