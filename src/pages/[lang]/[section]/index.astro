---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations } from '../../../i18n/ui';
import { LANGUAGES, DEFAULT_LANGUAGE, type Language } from '../../../i18n/languages';
import { path } from '../../../i18n/utils';
import { sectionColor } from '../../../i18n/sectionTheme';
import { getSections, getArticles } from '../../../lib/sanity';

export async function getStaticPaths() {
  const sections = await getSections();
  return LANGUAGES.flatMap((lang) =>
    sections.map((section) => ({
      params: { lang, section: section.id },
      props: { sectionId: section.id },
    })),
  );
}

const { lang } = Astro.params as { lang: Language };
const { sectionId } = Astro.props as { sectionId: string };
const t = useTranslations(lang);

const sections = await getSections();
const section = sections.find((s) => s.id === sectionId);
if (!section) return Astro.redirect(path(lang));

const sectionTitle = t.sections[section.id as keyof typeof t.sections] ?? section.title;
const sectionDesc = t.sectionDescriptions[section.id as keyof typeof t.sectionDescriptions] ?? section.description;

const allArticles = await getArticles();
const articles = allArticles.filter((a) => a.section === sectionId);
const cardColor = sectionColor(sectionId);
---

<BaseLayout lang={lang} title={sectionTitle} description={sectionDesc} currentPath={sectionId}>
  <header class="page-head" style={`--card-color: ${cardColor}`}>
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={path(lang)}>{t.nav.home}</a>
        <span class="sep">/</span>
        <span>{sectionTitle}</span>
      </nav>
      <h1><span class="page-head-icon">{section.icon}</span> {sectionTitle}</h1>
      <p class="lede">{sectionDesc}</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title" style="margin-bottom:0">{t.section.articlesIn}</h2>
      </div>

      {articles.length > 0 ? (
        <div class="article-list">
          {articles.map((article) => {
            const tr = lang !== DEFAULT_LANGUAGE
              ? article.translations?.find((x) => x.lang === lang)
              : undefined;
            const title = tr?.title ?? article.title;
            const description = tr?.description ?? article.description;
            return (
              <a href={path(lang, 'articles', article.id)} class="article-row" style={`--card-color: ${cardColor}`}>
                <div>
                  <h3>{title}</h3>
                  <p>{description}</p>
                  <div class="article-meta">
                    <span>
                      {new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'long', day: 'numeric' }).format(new Date(article.pubDate))}
                    </span>
                    <span class="dot">{article.readingTime} {t.article.readingTime}</span>
                  </div>
                </div>
                <span class="article-row-arrow">→</span>
              </a>
            );
          })}
        </div>
      ) : (
        <p class="section-sub">—</p>
      )}
    </div>
  </section>
</BaseLayout>
