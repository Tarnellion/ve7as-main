---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { useTranslations } from '../../../i18n/ui';
import { type Language } from '../../../i18n/languages';
import { path } from '../../../i18n/utils';
import { sectionColor } from '../../../i18n/sectionTheme';
import { getSections, getArticles, isBlockedInCountry } from '../../../lib/sanity';

const { lang, section: sectionId } = Astro.params as { lang: Language; section: string };
const t = useTranslations(lang);
const country = Astro.request.headers.get('cf-ipcountry') ?? '';

const sections = await getSections();
const section = sections.find((s) => s.id === sectionId);
if (!section) return Astro.redirect(path(lang));

const sectionTitle = t.sections[section.id as keyof typeof t.sections] ?? section.title;
const sectionDesc = t.sectionDescriptions[section.id as keyof typeof t.sectionDescriptions] ?? section.description;

const allArticles = await getArticles();
const articles = allArticles
  .filter((a) => a.section === sectionId)
  .filter((a) => !isBlockedInCountry(a.blockedIn, country));
const cardColor = sectionColor(sectionId);
---

<BaseLayout lang={lang} title={sectionTitle} description={sectionDesc} currentPath={sectionId}>
  <header class="page-head" style={`--card-color: ${cardColor}`}>
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={path(lang)}>{t.nav.home}</a>
        <span class="sep">/</span>
        <span>{sectionTitle}</span>
      </nav>
      <h1><span class="page-head-icon">{section.icon}</span> {sectionTitle}</h1>
      <p class="lede">{sectionDesc}</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      {articles.length > 0 ? (
        <div class="article-grid">
          {articles.map((article) => <ArticleCard lang={lang} article={article} />)}
        </div>
      ) : (
        <p class="section-sub">—</p>
      )}
    </div>
  </section>
</BaseLayout>
