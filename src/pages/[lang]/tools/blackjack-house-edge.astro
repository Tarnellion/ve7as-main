 *  иметь возможность проверить числа, не читая исходники. */
const WOO_CALCULATOR = 'https://wizardofodds.com/games/blackjack/calculator/';

/**
 * Калькулятор house edge блэкджека — четвёртый инструмент фазы 4.
 *
 * По ТЗ blackjack-house-edge-by-rules: топ кластера держат нематематические
 * страницы, а единственный существующий калькулятор живёт на аффилиатном
 * домене. Данные — src/data/blackjack-house-edge.ts, сняты с калькулятора
 * Wizard of Odds и проверены на аддитивность (артефакт в docs/seo/).
 *
 * Рамка из ТЗ соблюдается в копии: ниже кромка = меньше средний проигрыш,
 * НЕ способ выиграть; расходы — в юнитах, не в валюте; наборы с отрицательной
 * кромкой помечаются как не встречающиеся в реальности.
 */

const { lang } = Astro.params as { lang: Language };
if (!isLanguage(lang)) return Astro.rewrite('/404');

