    articleLink: 'Stratégie de base du blackjack',
  },
  br: {
    title: 'Calculadora de vantagem da casa: blackjack',
    description: 'Calcula a vantagem da casa pelas regras da mesa: pagamento 3:2 ou 6:5, S17/H17, DAS, baralhos, rendição. Números conferidos com o Wizard of Odds.',
    lede: 'Configure as regras da mesa — a calculadora mostra a vantagem da casa e o custo dela a cada 100 mãos. Menos vantagem é perder menos na média, não um jeito de ganhar.',
    payout: 'O blackjack paga', decks: 'Baralhos', soft17: 'Dealer no 17 suave', s17: 'Para (S17)', h17: 'Compra (H17)',
    das: 'Dobrar após dividir (DAS)', yes: 'Sim', no: 'Não',
    double: 'Dobrar permitido', dblAny: 'Quaisquer duas cartas', dbl911: 'Só 9–11', dbl1011: 'Só 10–11',
    resplit: 'Dividir até', hands: 'mãos',
    rsa: 'Redividir ases', hsa: 'Comprar em ases divididos',
    peek: 'Blackjack do dealer', peekYes: 'Com verificação (peek) / só a aposta original', peekNo: 'Regra europeia: perde tudo (ENHC)',
    surrender: 'Rendição', surNone: 'Não', surLate: 'Tardia (late)',
    edge: 'Vantagem da casa', edgeHint: 'Estratégia básica total-dependent com cut card. Modelo aditivo, desvio ≤ 0.013 pp do valor exato.',
    per100: 'Perda esperada a cada 100 mãos', per100Hint: 'Em unidades, apostando 1 unidade por mão. O preço médio de cem mãos nessa mesa.',
    negativeNote: 'A vantagem deu negativa — a favor do jogador. Mesas com essa combinação não existem na prática: confira se as regras não estão exageradas.',
    method: 'Dados: deltas capturadas da calculadora do Wizard of Odds (27/08/2026) e validadas em conjuntos empilhados. Toda mesa real é negativa para o jogador.',
    articleLink: 'Estratégia básica de blackjack',
  },
};

const c = COPY[lang];
const pageUrl = new URL(path(lang, 'tools', 'blackjack-house-edge'), Astro.site);

const schema = [
  {
    '@type': 'SoftwareApplication' as const,
    name: c.title,
    description: c.description,
    url: pageUrl.toString(),
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    inLanguage: HTML_LANG[lang],
  },
  breadcrumbs([
    { name: t.nav.home, url: new URL(path(lang), Astro.site).toString() },
    { name: c.title, url: pageUrl.toString() },
  ]),
];
---

<BaseLayout lang={lang} title={c.title} description={c.description} currentPath="tools/blackjack-house-edge" schema={schema}>
  <header class="page-head">
    <div class="container">
      <h1>{c.title}</h1>
      <p class="lede">{c.lede}</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="calc" id="bj-calc">
        <form class="calc-form" autocomplete="off">
          <div class="calc-field">
            <label for="bj-payout">{c.payout}</label>
            <select id="bj-payout">
              <option value="32" selected>3:2</option>
              <option value="65">6:5</option>
            </select>
          </div>
          <div class="calc-field">
            <label for="bj-decks">{c.decks}</label>
            <select id="bj-decks">
              <option value="1">1</option>
              <option value="2">2</option>
              <option value="4">4</option>
              <option value="5">5</option>
              <option value="6" selected>6</option>
              <option value="8">8</option>
            </select>
          </div>
          <div class="calc-field">
            <label for="bj-soft17">{c.soft17}</label>
            <select id="bj-soft17">
              <option value="s17" selected>{c.s17}</option>
              <option value="h17">{c.h17}</option>
            </select>
          </div>
          <div class="calc-field">
            <label for="bj-das">{c.das}</label>
            <select id="bj-das">
              <option value="yes" selected>{c.yes}</option>
              <option value="no">{c.no}</option>
            </select>
          </div>
          <div class="calc-field">
            <label for="bj-double">{c.double}</label>
            <select id="bj-double">
              <option value="any" selected>{c.dblAny}</option>
              <option value="9-11">{c.dbl911}</option>
              <option value="10-11">{c.dbl1011}</option>
            </select>
          </div>
          <div class="calc-field">
            <label for="bj-resplit">{c.resplit}</label>
            <select id="bj-resplit">
              <option value="2">2 {c.hands}</option>
              <option value="3">3 {c.hands}</option>
              <option value="4" selected>4 {c.hands}</option>
            </select>
          </div>
          <div class="calc-field">
            <label for="bj-rsa">{c.rsa}</label>
            <select id="bj-rsa">
              <option value="no" selected>{c.no}</option>
              <option value="yes">{c.yes}</option>
            </select>
          </div>
          <div class="calc-field">
            <label for="bj-hsa">{c.hsa}</label>
            <select id="bj-hsa">
              <option value="no" selected>{c.no}</option>
              <option value="yes">{c.yes}</option>
            </select>
          </div>
          <div class="calc-field">
            <label for="bj-peek">{c.peek}</label>
            <select id="bj-peek">
              <option value="peek" selected>{c.peekYes}</option>
              <option value="enhc">{c.peekNo}</option>
            </select>
          </div>
          <div class="calc-field">
            <label for="bj-surrender">{c.surrender}</label>
            <select id="bj-surrender">
              <option value="none" selected>{c.surNone}</option>
              <option value="late">{c.surLate}</option>
            </select>
          </div>
        </form>

        <div class="calc-results" aria-live="polite">
          <div class="calc-row calc-row--accent">
            <span class="calc-label">{c.edge}</span>
            <span class="calc-value" id="bj-edge">—</span>
            <small>{c.edgeHint}</small>
          </div>
          <div class="calc-row">
            <span class="calc-label">{c.per100}</span>
            <span class="calc-value" id="bj-per100">—</span>
            <small>{c.per100Hint}</small>
          </div>
          <p class="calc-note" id="bj-negative" hidden>{c.negativeNote}</p>
          <p class="calc-note">{c.method}</p>
        </div>
      </div>

      <p class="calc-article-link">
        <a href={path(lang, 'articles', 'blackjack-basic-strategy')}>{c.articleLink} →</a>
      </p>

      <ResponsibleGaming lang={lang} />
    </div>
  </section>
</BaseLayout>

<script>
  import { BJ_BASE_EDGE, BJ_DELTAS } from '../../../data/blackjack-house-edge';

  const $ = (id: string) => document.getElementById(id) as HTMLSelectElement;
  const out = (id: string) => document.getElementById(id)!;

  function recalc() {
    let edge = BJ_BASE_EDGE;
    edge += BJ_DELTAS.decks[Number($('bj-decks').value) as keyof typeof BJ_DELTAS.decks];
    if ($('bj-soft17').value === 'h17') edge += BJ_DELTAS.h17;
    if ($('bj-das').value === 'no') edge += BJ_DELTAS.noDas;
    edge += BJ_DELTAS.double[$('bj-double').value as keyof typeof BJ_DELTAS.double];
    edge += BJ_DELTAS.resplit[Number($('bj-resplit').value) as keyof typeof BJ_DELTAS.resplit];
    if ($('bj-rsa').value === 'yes') edge += BJ_DELTAS.rsa;
    if ($('bj-hsa').value === 'yes') edge += BJ_DELTAS.hsa;
    if ($('bj-peek').value === 'enhc') edge += BJ_DELTAS.enhcFullLoss;
    if ($('bj-surrender').value === 'late') edge += BJ_DELTAS.lateSurrender;
    if ($('bj-payout').value === '65') edge += BJ_DELTAS.pay65;

    out('bj-edge').textContent = `${edge.toFixed(2)} %`;
    out('bj-per100').textContent = edge.toFixed(1);
    (out('bj-negative') as HTMLElement).hidden = edge >= 0;
  }

  document.querySelectorAll('#bj-calc select').forEach((el) => el.addEventListener('change', recalc));
  recalc();
</script>
