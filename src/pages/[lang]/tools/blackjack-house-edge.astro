    faq: [
      ['What is the house edge in blackjack?', 'The average share of the initial bet the casino keeps when the player follows basic strategy. With common 6–8 deck rules and a 3:2 payout it is about 0.4–0.7%; with 6:5 about 1.8–2.0%.'],
      ['Why is 6:5 blackjack worse than 3:2?', `A natural pays 1.2 units instead of 1.5, so the player gives up 0.3 of a bet on every blackjack the dealer does not tie. That adds ${lo}–${hi} percentage points to the house edge, depending on the number of decks.`],
      ['Does a lower house edge mean I can win?', 'No. Every real rule set is negative for the player; a lower edge only means a smaller average loss per hand.'],
      ['How accurate is the calculator?', `It adds up rule effects measured on the Wizard of Odds calculator on 2026-08-27. On the combined rule sets we checked the sum stayed within ${tol} percentage points of the exact figure. The 6:5 penalty is our own closed-form calculation.`],
    ],
  },
  es: {
    title: 'Cuánto cambia la ventaja de la casa cada regla',
    intro: `Base: 8 barajas (mazos), el crupier se planta con 17 blando (17 suave), doblar con dos cartas cualesquiera, doblar tras dividir, dividir hasta 4 manos, blackjack 3:2. Ventaja de la casa: ${base} %. Cada fila cambia una sola regla.`,
    colRule: 'Regla', colChange: 'Cambio, puntos porcentuales',
    sourceBefore: 'Efectos de las reglas: ', sourceLink: 'calculadora de Wizard of Odds',
    sourceAfter: ', capturados el 27/08/2026; la fila del 6:5 es cálculo propio.',
    exampleTitle: 'Ejemplo: lo que cuesta el pago 6:5',
    example: `Seis barajas, el crupier pide con 17 blando, doblar tras dividir, blackjack 3:2: ventaja de la casa ${e32} %. La misma mesa pagando 6:5: ${e65} %. Por cada 100 manos de una unidad son ${e32} unidades frente a ${e65} de media, unas tres veces más.`,
    faqTitle: 'Preguntas frecuentes',
    faq: [
      ['¿Qué es la ventaja de la casa en el blackjack?', 'La parte media de la apuesta inicial que se queda el casino cuando el jugador sigue la estrategia básica. Con reglas habituales de 6–8 barajas y pago 3:2 ronda el 0,4–0,7 %; con pago 6:5, el 1,8–2,0 %.'],
      ['¿Por qué el blackjack 6:5 es peor que el 3:2?', `El blackjack natural paga 1,2 unidades en lugar de 1,5: el jugador pierde 0,3 apuestas en cada blackjack que el crupier no empata. Eso suma entre ${lo} y ${hi} puntos porcentuales a la ventaja de la casa, según el número de barajas.`],
      ['¿Una ventaja menor significa que se puede ganar?', 'No. Toda mesa real es negativa para el jugador; una ventaja menor solo significa una pérdida media más pequeña por mano.'],
      ['¿Qué precisión tiene la calculadora?', `Suma los efectos de cada regla medidos en la calculadora de Wizard of Odds el 27/08/2026. En los conjuntos combinados que comprobamos, la suma se desvió como máximo ${tol} puntos porcentuales del valor exacto. La penalización del 6:5 es cálculo propio.`],
    ],
  },
};

const rules = RULES_COPY[lang];
---

<BaseLayout lang={lang} title={c.metaTitle ?? c.title} description={c.description} currentPath="tools/blackjack-house-edge" schema={schema}>
  <header class="page-head">
    <div class="container">
      <nav class="breadcrumb" aria-label={t.nav.breadcrumb}>
        <a href={path(lang)}>{t.nav.home}</a>
        <span class="sep">/</span>
        <a href={path(lang, 'tools')}>{TOOLS_INDEX_TITLE[lang]}</a>
      </nav>
      <h1>{c.title}</h1>
      <p class="lede">{c.lede}</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="calc" id="bj-calc">
        <form class="calc-form" autocomplete="off">
          <div class="calc-field">
            <label for="bj-payout">{c.payout}</label>
            <select id="bj-payout">
              <option value="32" selected>3:2</option>
              <option value="65">6:5</option>
            </select>
          </div>
          <div class="calc-field">
            <label for="bj-decks">{c.decks}</label>
            <select id="bj-decks">
              <option value="1">1</option>
              <option value="2">2</option>
              <option value="4">4</option>
              <option value="5">5</option>
              <option value="6" selected>6</option>
              <option value="8">8</option>
            </select>
          </div>
          <div class="calc-field">
            <label for="bj-soft17">{c.soft17}</label>
            <select id="bj-soft17">
              <option value="s17" selected>{c.s17}</option>
              <option value="h17">{c.h17}</option>
            </select>
          </div>
          <div class="calc-field">
            <label for="bj-das">{c.das}</label>
            <select id="bj-das">
              <option value="yes" selected>{c.yes}</option>
              <option value="no">{c.no}</option>
            </select>
          </div>
          <div class="calc-field">
            <label for="bj-double">{c.double}</label>
            <select id="bj-double">
              <option value="any" selected>{c.dblAny}</option>
              <option value="9-11">{c.dbl911}</option>
              <option value="10-11">{c.dbl1011}</option>
            </select>
          </div>
          <div class="calc-field">
            <label for="bj-resplit">{c.resplit}</label>
            <select id="bj-resplit">
              <option value="2">2 {c.hands}</option>
              <option value="3">3 {c.hands}</option>
              <option value="4" selected>4 {c.hands}</option>
            </select>
          </div>
          <div class="calc-field">
            <label for="bj-rsa">{c.rsa}</label>
            <select id="bj-rsa">
              <option value="no" selected>{c.no}</option>
              <option value="yes">{c.yes}</option>
            </select>
          </div>
          <div class="calc-field">
            <label for="bj-hsa">{c.hsa}</label>
            <select id="bj-hsa">
              <option value="no" selected>{c.no}</option>
              <option value="yes">{c.yes}</option>
            </select>
          </div>
          <div class="calc-field">
            <label for="bj-peek">{c.peek}</label>
            <select id="bj-peek">
              <option value="peek" selected>{c.peekYes}</option>
              <option value="enhc">{c.peekNo}</option>
            </select>
          </div>
          <div class="calc-field">
            <label for="bj-surrender">{c.surrender}</label>
            <select id="bj-surrender">
              <option value="none" selected>{c.surNone}</option>
              <option value="late">{c.surLate}</option>
            </select>
          </div>
        </form>

        <div class="calc-results" aria-live="polite">
          <div class="calc-row calc-row--accent">
            <span class="calc-label">{c.edge}</span>
            <span class="calc-value" id="bj-edge">—</span>
            <small>{c.edgeHint}</small>
          </div>
          <div class="calc-row">
            <span class="calc-label">{c.per100}</span>
            <span class="calc-value" id="bj-per100">—</span>
            <small>{c.per100Hint}</small>
          </div>
          <p class="calc-note" id="bj-negative" hidden>{c.negativeNote}</p>
          <p class="calc-note">{c.methodBefore}<a href={WOO_CALCULATOR} rel="noopener" target="_blank">{c.methodLink}</a>{c.methodAfter}</p>
        </div>
      </div>

      <p class="calc-article-link">
        <a href={path(lang, 'articles', 'blackjack-basic-strategy')}>{c.articleLink} →</a>
      </p>

      {rules && (
        <div class="prose">
          <h2>{rules.title}</h2>
          <p>{rules.intro}</p>
          <table>
            <thead>
              <tr><th>{rules.colRule}</th><th>{rules.colChange}</th></tr>
            </thead>
            <tbody>
              {RULE_ROWS.map((row) => (
                <tr><td>{row[lang]}</td><td>{dec(sign(row.delta))}</td></tr>
              ))}
            </tbody>
          </table>
          <p>{rules.sourceBefore}<a href={WOO_CALCULATOR} rel="noopener">{rules.sourceLink}</a>{rules.sourceAfter}</p>
          <h2>{rules.exampleTitle}</h2>
          <p>{rules.example}</p>
          <h2>{rules.faqTitle}</h2>
          {rules.faq.map(([question, answer]) => (
            <Fragment>
              <h3>{question}</h3>
              <p>{answer}</p>
            </Fragment>
          ))}
        </div>
      )}

      <ResponsibleGaming lang={lang} />
    </div>
  </section>

  <RelatedTools lang={lang} current="blackjack-house-edge" />
</BaseLayout>

<script>
  import { BJ_BASE_EDGE, BJ_DELTAS } from '../../../data/blackjack-house-edge';

  const $ = (id: string) => document.getElementById(id) as HTMLSelectElement;
  const out = (id: string) => document.getElementById(id)!;
  // Результат печатается по локали страницы, а не через toFixed: таблица
  // правил ниже на испанской странице уже с запятой, и «0.64 %» над ней
  // выглядел бы числом из другого документа.
  const nf = (x: number, n: number) =>
    new Intl.NumberFormat(document.documentElement.lang, { minimumFractionDigits: n, maximumFractionDigits: n }).format(x);

  function recalc() {
    // Число колод читается один раз: от него зависит не только собственная
    // дельта, но и штраф за выплату 6:5 (см. шапку blackjack-house-edge.ts).
    const decks = Number($('bj-decks').value) as keyof typeof BJ_DELTAS.decks;

    let edge = BJ_BASE_EDGE;
    edge += BJ_DELTAS.decks[decks];
    if ($('bj-soft17').value === 'h17') edge += BJ_DELTAS.h17;
    if ($('bj-das').value === 'no') edge += BJ_DELTAS.noDas;
    edge += BJ_DELTAS.double[$('bj-double').value as keyof typeof BJ_DELTAS.double];
    edge += BJ_DELTAS.resplit[Number($('bj-resplit').value) as keyof typeof BJ_DELTAS.resplit];
    if ($('bj-rsa').value === 'yes') edge += BJ_DELTAS.rsa;
    if ($('bj-hsa').value === 'yes') edge += BJ_DELTAS.hsa;
    if ($('bj-peek').value === 'enhc') edge += BJ_DELTAS.enhcFullLoss;
    if ($('bj-surrender').value === 'late') edge += BJ_DELTAS.lateSurrender;
    if ($('bj-payout').value === '65') edge += BJ_DELTAS.pay65[decks];

    out('bj-edge').textContent = `${nf(edge, 2)} %`;
    out('bj-per100').textContent = nf(edge, 1);
    (out('bj-negative') as HTMLElement).hidden = edge >= 0;
  }

  document.querySelectorAll('#bj-calc select').forEach((el) => el.addEventListener('change', recalc));
  recalc();
</script>
