---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { isLanguage, HTML_LANG, type Language } from '../../../i18n/languages';
import { path } from '../../../i18n/utils';
import { useTranslations } from '../../../i18n/ui';
import { breadcrumbs } from '../../../lib/schema';
import ResponsibleGaming from '../../../components/ResponsibleGaming.astro';

/**
 * Калькулятор house edge блэкджека — четвёртый инструмент фазы 4.
 *
 * По ТЗ blackjack-house-edge-by-rules: топ кластера держат нематематические
 * страницы, а единственный существующий калькулятор живёт на аффилиатном
 * домене. Данные — src/data/blackjack-house-edge.ts, сняты с калькулятора
 * Wizard of Odds и проверены на аддитивность (артефакт в docs/seo/).
 *
 * Рамка из ТЗ соблюдается в копии: ниже кромка = меньше средний проигрыш,
 * НЕ способ выиграть; расходы — в юнитах, не в валюте; наборы с отрицательной
 * кромкой помечаются как не встречающиеся в реальности.
 */

const { lang } = Astro.params as { lang: Language };
if (!isLanguage(lang)) return Astro.rewrite('/404');

const t = useTranslations(lang);

type Copy = {
  title: string; description: string; lede: string;
  payout: string; decks: string; soft17: string; s17: string; h17: string;
  das: string; yes: string; no: string;
  double: string; dblAny: string; dbl911: string; dbl1011: string;
  resplit: string; hands: string;
  rsa: string; hsa: string;
  peek: string; peekYes: string; peekNo: string;
  surrender: string; surNone: string; surLate: string;
  edge: string; edgeHint: string;
  per100: string; per100Hint: string;
  negativeNote: string;
  method: string;
  articleLink: string;
};

