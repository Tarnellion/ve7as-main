    double: 'Verdoppeln erlaubt', dblAny: 'Beliebige zwei Karten', dbl911: 'Nur 9–11', dbl1011: 'Nur 10–11',
    resplit: 'Teilen bis zu', hands: 'Händen',
    rsa: 'Asse erneut teilen', hsa: 'Zu geteilten Assen ziehen',
    peek: 'Dealer-Blackjack', peekYes: 'Mit Prüfung (Peek) / nur Grundeinsatz verloren', peekNo: 'Europäische Regel: alles verloren (ENHC)',
    surrender: 'Aufgabe', surNone: 'Keine', surLate: 'Späte (Late)',
    edge: 'Hausvorteil', edgeHint: 'Total-dependent Basisstrategie mit Cut Card. Additives Modell, Abweichung ≤ 0.013 Pp vom exakten Wert.',
