/**
 * Справочный блок под калькулятором: таблица влияния правил, пример 6:5, вопросы.
 *
 * Числа таблицы и примера не набраны руками — они считаются из BJ_BASE_EDGE и
 * BJ_DELTAS, тех же данных, по которым считает форма выше. Набранная цифра
 * разошлась бы с калькулятором при первом же обновлении замеров, и страница
 * противоречила бы сама себе. Исключение — округлённые диапазоны в первом
 * вопросе и 1.2 / 1.5 / 0.3 во втором: это проза, её при смене данных надо
 * перечитать глазами.
 *
 * Рамка: это НЕ собственные данные. Эффекты правил сняты с калькулятора
 * Wizard of Odds, своё здесь только слагаемое 6:5 — поэтому таблица нигде не
 * названа уникальной или оригинальной, а источник стоит сразу под ней.
 *
 * В прозе нет фразы про одну колоду: допуск аддитивной модели на одноколодных
 * наборах не измерялся (scripts/verify-blackjack-data.mjs). Строка «1 колода»
 * в таблице — одиночная снятая дельта, а не сумма, к ней допуск не относится.
 *
 * Блок есть только у en и es: локаль без копии его не рендерит. Разметки
 * FAQPage нет намеренно — тип страницы SoftwareApplication.
 */

// Десятичная запятая для es — в каждом печатаемом числе блока.
const dec = (s: string) => (lang === 'es' ? s.replace('.', ',') : s);
// Минус — U+2212, а не дефис: в столбце табличных цифр он равен по ширине «+».
const sign = (v: number) => (v > 0 ? '+' : '−') + Math.abs(v).toFixed(2);

type RuleRow = { delta: number } & Partial<Record<Language, string>>;

// pay65 берётся для 8 колод: каждая строка меняет одно правило относительно
// восьмиколодной базы, а не относительно стола из примера ниже.
const RULE_ROWS: RuleRow[] = [
  { delta: BJ_DELTAS.pay65[8], en: 'Blackjack pays 6:5 instead of 3:2', es: 'El blackjack paga 6:5 en vez de 3:2' },
  { delta: BJ_DELTAS.h17, en: 'Dealer hits soft 17 (H17)', es: 'El crupier pide con 17 blando (H17)' },
  { delta: BJ_DELTAS.double['10-11'], en: 'Double on 10–11 only', es: 'Doblar solo con 10–11' },
  { delta: BJ_DELTAS.noDas, en: 'No double after split', es: 'Sin doblar tras dividir' },
  { delta: BJ_DELTAS.enhcFullLoss, en: 'European no hole card, all bets lost', es: 'Regla europea sin carta tapada, se pierde todo' },
  { delta: BJ_DELTAS.double['9-11'], en: 'Double on 9–11 only', es: 'Doblar solo con 9–11' },
  { delta: BJ_DELTAS.resplit[2], en: 'Split to 2 hands only', es: 'Dividir solo hasta 2 manos' },
  { delta: BJ_DELTAS.decks[6], en: '6 decks instead of 8', es: '6 barajas en vez de 8' },
  { delta: BJ_DELTAS.rsa, en: 'Resplit aces', es: 'Volver a dividir ases' },
  { delta: BJ_DELTAS.lateSurrender, en: 'Late surrender', es: 'Rendición tardía' },
  { delta: BJ_DELTAS.hsa, en: 'Hit split aces', es: 'Pedir carta tras dividir ases' },
  { delta: BJ_DELTAS.decks[2], en: '2 decks', es: '2 barajas' },
  { delta: BJ_DELTAS.decks[1], en: '1 deck', es: '1 baraja' },
];

const base = dec(BJ_BASE_EDGE.toFixed(2));
const e32 = dec((BJ_BASE_EDGE + BJ_DELTAS.decks[6] + BJ_DELTAS.h17).toFixed(2));
const e65 = dec((BJ_BASE_EDGE + BJ_DELTAS.decks[6] + BJ_DELTAS.h17 + BJ_DELTAS.pay65[6]).toFixed(2));
const pay65All = Object.values(BJ_DELTAS.pay65);
const lo = dec(Math.min(...pay65All).toFixed(2));
const hi = dec(Math.max(...pay65All).toFixed(2));
const tol = dec(String(BJ_MODEL_TOLERANCE));

type RulesCopy = {
  title: string; intro: string; colRule: string; colChange: string;
  sourceBefore: string; sourceLink: string; sourceAfter: string;
  exampleTitle: string; example: string;
  faqTitle: string; faq: [question: string, answer: string][];
};

