---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { isLanguage, HTML_LANG, type Language } from '../../../i18n/languages';
import { path } from '../../../i18n/utils';
import { useTranslations } from '../../../i18n/ui';
import { breadcrumbs } from '../../../lib/schema';
import ResponsibleGaming from '../../../components/ResponsibleGaming.astro';
import RelatedTools from '../../../components/RelatedTools.astro';
import { TOOLS_INDEX_TITLE } from '../../../data/tools';

/**
 * Калькулятор маржи букмекера — третий инструмент фазы 4.
 *
 * Показывает то, что букмекеры не публикуют: сколько линия стоит игроку.
 * Считает overround, маржу и «честные» коэффициенты без маржи (no-vig) —
 * подразумеваемые вероятности нормируются к 100 %.
 *
 * Расчёт клиентский. Копия — локальный словарь, не ui.ts.
 */

const { lang } = Astro.params as { lang: Language };
if (!isLanguage(lang)) return Astro.rewrite('/404');

const t = useTranslations(lang);

type Copy = {
  title: string; metaTitle?: string; description: string; lede: string;
  format: string; decimal: string; american: string; fractional: string;
  outcome: string; add: string;
  sum: string; sumHint: string;
  overround: string; overroundHint: string;
  margin: string; marginHint: string;
  fair: string; fairHint: string;
  converterLink: string;
  disclaimer: string;
  // Разбор под калькулятором есть только у индексируемых локалей (en, es);
  // остальные рендерятся с noindex, поэтому поля необязательные.
  explainer?: { h2: string; body: string };
  examplesTitle?: string; examples?: string[];
  faqTitle?: string; faq?: { q: string; a: string }[];
};

const COPY: Record<Language, Copy> = {
  ru: {
    title: 'Калькулятор маржи букмекера',
    description: 'Считает маржу линии по десятичным коэффициентам и показывает честные коэффициенты без маржи (no-vig). Без регистрации.',
    lede: 'Введите десятичные коэффициенты исходов — двух для матчей без ничьей, трёх для линии с ничьей.',
    format: 'Формат коэффициента', decimal: 'Десятичный', american: 'Американский', fractional: 'Дробный',
    outcome: 'Исход', add: 'Добавить исход',
    sum: 'Сумма подразумеваемых вероятностей',
    sumHint: 'У честной линии было бы ровно 100 %. Всё сверх — цена, встроенная в коэффициенты.',
    overround: 'Оверраунд',
    overroundHint: 'На сколько сумма подразумеваемых вероятностей превышает 100 %.',
    margin: 'Маржа букмекера',
    marginHint: '(S − 1) / S, где S — сумма вероятностей. Доля оборота, которую линия удерживает в среднем.',
    fair: 'Честные коэффициенты (no-vig)',
    fairHint: 'Коэффициенты после нормировки вероятностей к 100 % — какой была бы линия без комиссии.',
    converterLink: 'Конвертер форматов коэффициентов',
    disclaimer: 'Калькулятор оценивает маржу по методу пропорциональной нормировки. Реальная маржа распределяется по исходам неравномерно, особенно на фаворитах и аутсайдерах. Проверяйте расчёты самостоятельно.',
  },
  en: {
    title: 'Bookmaker margin and no-vig calculator',
    metaTitle: 'No-vig & bookmaker margin calculator (overround)',
    description: 'Enter a market’s odds (decimal, American or fractional) to get the overround, the bookmaker’s margin and the fair no-vig odds. Free, no sign-up.',
    lede: 'Enter the odds of every outcome in decimal, American or fractional format: two for a no-draw market, three for 1X2, more for outrights.',
    format: 'Odds format', decimal: 'Decimal', american: 'American', fractional: 'Fractional',
    outcome: 'Outcome', add: 'Add outcome',
    sum: 'Sum of implied probabilities',
    sumHint: 'A fair line would sum to exactly 100%. Anything above is the price built into the odds.',
    overround: 'Overround (vig)',
    overroundHint: 'How far the implied probabilities exceed 100%.',
    margin: 'Margin (theoretical hold)',
    marginHint: '(S − 1) / S, where S is the probability sum. The share of turnover the line keeps on average.',
    fair: 'Fair odds (no-vig)',
    fairHint: 'Odds after normalising probabilities to 100% — what the line would be without commission.',
    converterLink: 'Odds format converter',
    disclaimer: 'The calculator uses proportional normalisation. Real margin is distributed unevenly across outcomes, especially on favourites and longshots. Verify calculations yourself.',
    explainer: {
      h2: 'How bookmaker margin is calculated',
      body: 'Convert each price to an implied probability (1 ÷ decimal odds) and add them up. A fair market sums to 100%; the excess is the overround, also called vig or juice. Margin, or theoretical hold, is the overround as a share of the total: (S − 1) ÷ S. Fair no-vig odds are each price multiplied by S.',
    },
    examplesTitle: 'Worked examples',
    examples: [
      'Two-way market at −110 / −110 (decimal 1.909 each): 52.38% + 52.38% = 104.76%. Overround 4.76%, margin 4.55%, fair odds 2.00 / 2.00 (+100 / +100).',
      'Three-way football market at 2.10 / 3.40 / 3.60: 47.62% + 29.41% + 27.78% = 104.81%. Overround 4.81%, margin 4.59%, fair odds 2.201 / 3.563 / 3.773.',
    ],
    faqTitle: 'Questions',
    faq: [
      {
        q: 'What is the difference between margin, overround, vig and hold?',
        a: 'Overround (vig, juice) is how far the implied probabilities exceed 100%: S − 1. Margin, or theoretical hold, is the share of all stakes the book keeps when its action is balanced: (S − 1) ÷ S. For −110 / −110 they are 4.76% and 4.55%.',
      },
      {
        q: 'What are no-vig odds?',
        a: 'The prices left after the margin is removed so that the probabilities sum to exactly 100%. They estimate the bookmaker’s own view of the fair price; they are not a guaranteed true probability.',
