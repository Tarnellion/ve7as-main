    margin: 'Buchmachermarge',
    marginHint: '(S − 1) / S, wobei S die Wahrscheinlichkeitssumme ist. Der Anteil des Umsatzes, den die Linie im Schnitt einbehält.',
    fair: 'Faire Quoten (No-Vig)',
    fairHint: 'Quoten nach Normierung der Wahrscheinlichkeiten auf 100 % — die Linie ohne Kommission.',
    converterLink: 'Quotenformat-Rechner',
    disclaimer: 'Der Rechner nutzt proportionale Normierung. Die reale Marge verteilt sich ungleich auf die Ausgänge. Prüfen Sie die Rechnung selbst.',
  },
  fr: {
    title: 'Calculateur de marge du bookmaker',
    description: 'Calcule la marge d’une ligne à partir des cotes décimales et montre les cotes justes sans marge (no-vig). Sans inscription.',
    lede: 'Saisissez les cotes décimales des résultats — deux pour les marchés sans nul, trois pour les lignes avec nul. Le troisième champ peut rester vide.',
    outcome: 'Résultat', optional: 'facultatif',
    sum: 'Somme des probabilités implicites',
    sumHint: 'Une ligne juste totaliserait exactement 100 %. Tout excédent est le prix intégré aux cotes.',
    margin: 'Marge du bookmaker',
    marginHint: '(S − 1) / S, où S est la somme des probabilités. La part du volume que la ligne retient en moyenne.',
    fair: 'Cotes justes (no-vig)',
    fairHint: 'Cotes après normalisation des probabilités à 100 % — la ligne sans commission.',
    converterLink: 'Convertisseur de formats de cotes',
    disclaimer: 'Le calculateur utilise la normalisation proportionnelle. La marge réelle se répartit inégalement entre les résultats. Vérifiez les calculs vous-même.',
  },
  br: {
    title: 'Calculadora de margem da casa',
    description: 'Calcula a margem de uma linha a partir de odds decimais e mostra as odds justas sem margem (no-vig). Sem cadastro.',
    lede: 'Digite as odds decimais dos resultados — duas para mercados sem empate, três para linhas com empate. O terceiro campo pode ficar vazio.',
    outcome: 'Resultado', optional: 'opcional',
    sum: 'Soma das probabilidades implícitas',
    sumHint: 'Uma linha justa somaria exatamente 100 %. Tudo acima é o preço embutido nas odds.',
    margin: 'Margem da casa',
    marginHint: '(S − 1) / S, onde S é a soma das probabilidades. A parte do volume que a linha retém em média.',
    fair: 'Odds justas (no-vig)',
    fairHint: 'Odds após normalizar as probabilidades para 100 % — como seria a linha sem comissão.',
    converterLink: 'Conversor de formatos de odds',
    disclaimer: 'A calculadora usa normalização proporcional. A margem real se distribui de forma desigual entre os resultados. Confira os cálculos.',
  },
};

const c = COPY[lang];
const pageUrl = new URL(path(lang, 'tools', 'margin-calculator'), Astro.site);

const schema = [
  {
    '@type': 'SoftwareApplication' as const,
    name: c.title,
    description: c.description,
    url: pageUrl.toString(),
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    inLanguage: HTML_LANG[lang],
  },
  breadcrumbs([
    { name: t.nav.home, url: new URL(path(lang), Astro.site).toString() },
    { name: c.title, url: pageUrl.toString() },
  ]),
];
---

<BaseLayout lang={lang} title={c.title} description={c.description} currentPath="tools/margin-calculator" schema={schema}>
  <header class="page-head">
    <div class="container">
      <h1>{c.title}</h1>
      <p class="lede">{c.lede}</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="calc" id="margin-calc">
        <form class="calc-form" autocomplete="off">
          <div class="calc-field">
            <label for="mc-o1">{c.outcome} 1</label>
            <input id="mc-o1" type="number" min="1.001" step="any" value="1.90" inputmode="decimal" />
          </div>
          <div class="calc-field">
            <label for="mc-o2">{c.outcome} 2</label>
            <input id="mc-o2" type="number" min="1.001" step="any" value="1.90" inputmode="decimal" />
          </div>
          <div class="calc-field">
            <label for="mc-o3">{c.outcome} 3 ({c.optional})</label>
            <input id="mc-o3" type="number" min="1.001" step="any" value="" inputmode="decimal" />
          </div>
        </form>

        <div class="calc-results" aria-live="polite">
          <div class="calc-row">
            <span class="calc-label">{c.sum}</span>
            <span class="calc-value" id="mc-sum">—</span>
            <small>{c.sumHint}</small>
          </div>
          <div class="calc-row calc-row--accent">
            <span class="calc-label">{c.margin}</span>
            <span class="calc-value" id="mc-margin">—</span>
            <small>{c.marginHint}</small>
          </div>
          <div class="calc-row">
            <span class="calc-label">{c.fair}</span>
            <span class="calc-value calc-value--list" id="mc-fair">—</span>
            <small>{c.fairHint}</small>
          </div>
          <p class="calc-article-link">
            <a href={path(lang, 'tools', 'odds-converter')}>{c.converterLink} →</a>
          </p>
        </div>
      </div>

      <p class="notice">{c.disclaimer}</p>

      <ResponsibleGaming lang={lang} />
    </div>
  </section>
</BaseLayout>

<script>
  // p_i = 1/d_i; S = Σp_i; overround = S − 1; маржа = (S − 1)/S.
  // No-vig (пропорциональная нормировка): честная вероятность p_i/S,
  // честный коэффициент 1/(p_i/S) = S·d_i. Проверка: 1.90/1.90 → S≈1.0526,
  // честные 2.00/2.00 — монетка без комиссии.
  const ids = ['mc-o1', 'mc-o2', 'mc-o3'];
  const out = (id: string) => document.getElementById(id)!;

  function recalc() {
    const odds = ids
      .map((id) => Number((document.getElementById(id) as HTMLInputElement).value))
      .filter((v) => Number.isFinite(v) && v > 1.001);
    if (odds.length < 2) {
      out('mc-sum').textContent = out('mc-margin').textContent = out('mc-fair').textContent = '—';
      return;
    }
    const probs = odds.map((d) => 1 / d);
    const S = probs.reduce((a, b) => a + b, 0);
    const margin = (S - 1) / S;
    out('mc-sum').textContent = `${(S * 100).toFixed(2)} %`;
    out('mc-margin').textContent = `${(margin * 100).toFixed(2)} %`;
    out('mc-fair').textContent = odds.map((d) => (d * S).toFixed(3)).join(' · ');
  }

  ids.forEach((id) => document.getElementById(id)!.addEventListener('input', recalc));
  recalc();
</script>
