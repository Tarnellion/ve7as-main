    disclaimer: 'Калькулятор оценивает маржу по методу пропорциональной нормировки. Реальная маржа распределяется по исходам неравномерно, особенно на фаворитах и аутсайдерах. Проверяйте расчёты самостоятельно.',
  },
  en: {
    title: 'Bookmaker margin calculator',
    description: 'Calculates a line’s margin from decimal odds and shows the fair no-vig odds. No sign-up.',
    lede: 'Enter the decimal odds of the outcomes — two for no-draw markets, three for lines with a draw. The third field may stay empty.',
    outcome: 'Outcome', optional: 'optional',
    sum: 'Sum of implied probabilities',
    sumHint: 'A fair line would sum to exactly 100%. Anything above is the price built into the odds.',
    margin: 'Bookmaker margin',
    marginHint: '(S − 1) / S, where S is the probability sum. The share of turnover the line keeps on average.',
