const c = COPY[lang];
const pageUrl = new URL(path(lang, 'tools', 'wagering-calculator'), Astro.site);

const schema = [
  {
    '@type': 'SoftwareApplication' as const,
    name: c.title,
    description: c.description,
    url: pageUrl.toString(),
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    inLanguage: HTML_LANG[lang],
  },
  // Три уровня, и средний — указатель: та же цепочка стоит над <h1>.
  // Разметка обязана повторять видимую иерархию, поэтому правятся они вместе.
  breadcrumbs([
    { name: t.nav.home, url: new URL(path(lang), Astro.site).toString() },
    { name: TOOLS_INDEX_TITLE[lang], url: new URL(path(lang, 'tools'), Astro.site).toString() },
    { name: c.title, url: pageUrl.toString() },
  ]),
];
---

<BaseLayout lang={lang} title={c.metaTitle ?? c.title} description={c.description} currentPath="tools/wagering-calculator" schema={schema}>
  <header class="page-head">
    <div class="container">
      <nav class="breadcrumb" aria-label={t.nav.breadcrumb}>
        <a href={path(lang)}>{t.nav.home}</a>
        <span class="sep">/</span>
        <a href={path(lang, 'tools')}>{TOOLS_INDEX_TITLE[lang]}</a>
      </nav>
      <h1>{c.title}</h1>
      <p class="lede">{c.lede}</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="calc" id="wagering-calc">
        <form class="calc-form" autocomplete="off">
          {/* Значения по умолчанию (100, ×35, 100 %, RTP 96) — это пример из прозы ниже (explainer): меняете одно — правьте и другое. */}
          <div class="calc-field">
            <label for="wc-bonus">{c.bonus}</label>
            <input id="wc-bonus" type="number" min="0" step="any" value="100" inputmode="decimal" />
          </div>
          <div class="calc-field">
            <label for="wc-deposit">{c.deposit}</label>
            <input id="wc-deposit" type="number" min="0" step="any" value="0" inputmode="decimal" />
            <small>{c.depositHint}</small>
          </div>
          <div class="calc-field">
            <label for="wc-mult">{c.multiplier}</label>
            <input id="wc-mult" type="number" min="1" step="any" value="35" inputmode="decimal" />
            <small>{c.multiplierHint}</small>
          </div>
          <div class="calc-field">
            <label for="wc-weight">{c.weighting}</label>
            <input id="wc-weight" type="number" min="1" max="100" step="any" value="100" inputmode="decimal" />
            <small>{c.weightingHint}</small>
          </div>
          <div class="calc-field">
            <label for="wc-rtp">{c.rtp}</label>
            <input id="wc-rtp" type="number" min="1" max="99.9" step="any" value="96" inputmode="decimal" />
            <small>{c.rtpHint}</small>
          </div>
          <div class="calc-field">
            <label for="wc-bet">{c.betSize}</label>
            <input id="wc-bet" type="number" min="0" step="any" value="1" inputmode="decimal" />
          </div>
        </form>

        <div class="calc-results" aria-live="polite">
          <div class="calc-row">
            <span class="calc-label">{c.turnover}</span>
            <span class="calc-value" id="wc-turnover">—</span>
            <small>{c.turnoverNote}</small>
          </div>
          <div class="calc-row">
            <span class="calc-label">{c.effectiveTurnover}</span>
            <span class="calc-value" id="wc-effective">—</span>
          </div>
          <div class="calc-row">
            <span class="calc-label">{c.bets}</span>
            <span class="calc-value" id="wc-bets">—</span>
          </div>
          <div class="calc-row calc-row--accent">
            <span class="calc-label">{c.expectedCost}</span>
            <span class="calc-value" id="wc-cost">—</span>
            <small>{c.expectedCostNote}</small>
          </div>
          <p class="calc-note" id="wc-verdict" hidden>{c.verdictNote}</p>
        </div>
      </div>

      <p class="notice">{c.disclaimer}</p>

      <p class="calc-article-link">
        <a href={path(lang, 'articles', 'wagering-explained')}>{c.articleLink} →</a>
      </p>

      {(c.explainer || c.faq) && (
        <div class="prose">
          {c.explainer?.map((b) => (<><h2>{b.h2}</h2><p>{b.body}</p></>))}
          {c.faq && <h2>{c.faqTitle}</h2>}
          {c.faq?.map((f) => (<><h3>{f.q}</h3><p>{f.a}</p></>))}
        </div>
      )}

      <ResponsibleGaming lang={lang} />
    </div>
  </section>

  <RelatedTools lang={lang} current="wagering-calculator" />
</BaseLayout>

<script>
  // Чистая арифметика без сети. Формулы:
  //   оборот           = (бонус + депозит?) × множитель
  //   фактический      = оборот / (вклад / 100)  — при вкладе 50% крутить надо вдвое больше
  //   ожидаемые потери = фактический × (1 − RTP/100)
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const out = (id: string) => document.getElementById(id)!;

  const fmt = new Intl.NumberFormat(document.documentElement.lang, { maximumFractionDigits: 2 });

  function recalc() {
    const bonus = Math.max(0, Number($('wc-bonus').value) || 0);
    const deposit = Math.max(0, Number($('wc-deposit').value) || 0);
    const mult = Math.max(1, Number($('wc-mult').value) || 1);
    const weight = Math.min(100, Math.max(1, Number($('wc-weight').value) || 100));
    const rtp = Math.min(99.9, Math.max(1, Number($('wc-rtp').value) || 96));
    const bet = Math.max(0, Number($('wc-bet').value) || 0);

    const turnover = (bonus + deposit) * mult;
    const effective = turnover / (weight / 100);
    const cost = effective * (1 - rtp / 100);

    out('wc-turnover').textContent = fmt.format(turnover);
    out('wc-effective').textContent = fmt.format(effective);
    out('wc-bets').textContent = bet > 0 ? fmt.format(Math.ceil(effective / bet)) : '—';
    out('wc-cost').textContent = fmt.format(cost);
    (out('wc-verdict') as HTMLElement).hidden = !(bonus > 0 && cost > bonus);
  }

  document.querySelectorAll('#wagering-calc input').forEach((el) => el.addEventListener('input', recalc));
  recalc();
</script>
