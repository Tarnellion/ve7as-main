---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { isLanguage, HTML_LANG, type Language } from '../../../i18n/languages';
import { path } from '../../../i18n/utils';
import { useTranslations } from '../../../i18n/ui';
import { breadcrumbs } from '../../../lib/schema';
import ResponsibleGaming from '../../../components/ResponsibleGaming.astro';

/**
 * Калькулятор вейджера — первый инструмент-магнит из фазы 4 SEO-роадмапа.
 *
 * Топ выдачи по «wagering requirement» состоит из страниц с калькуляторами;
 * текст без инструмента там не конкурент. Отличие этого калькулятора от
 * существующих — честная «цена отыгрыша»: он считает не только оборот, но и
 * ожидаемые потери на этом обороте через house edge, то есть показывает,
 * сколько бонус стоит на самом деле.
 *
 * Весь расчёт — клиентский JS без единого запроса: нулевой бюджет проекта
 * не тратится, квота Sanity не расходуется, страница работает без сети.
 *
 * Копия инструмента лежит локальным словарём, а не в `ui.ts`: это тексты
 * одной страницы, и раздувать глобальный Translation ради них не нужно —
 * тот же приём, что у DATA_ERROR_COPY в sanity.ts.
 */

const { lang } = Astro.params as { lang: Language };
if (!isLanguage(lang)) return Astro.rewrite('/404');

const t = useTranslations(lang);

type ToolCopy = {
  title: string;
  metaTitle: string;
  description: string;
  lede: string;
  bonus: string;
  deposit: string;
  depositHint: string;
  multiplier: string;
  multiplierHint: string;
  weighting: string;
  weightingHint: string;
  rtp: string;
  rtpHint: string;
  betSize: string;
  turnover: string;
  turnoverNote: string;
  effectiveTurnover: string;
  bets: string;
  expectedCost: string;
  expectedCostNote: string;
  verdictNote: string;
  disclaimer: string;
  articleLink: string;
};

