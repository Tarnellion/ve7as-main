---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations } from '../../../i18n/ui';
import { HTML_LANG, isLanguage, type Language } from '../../../i18n/languages';
import { path } from '../../../i18n/utils';
import { getArticleBySlug, renderMarkdown, isBlockedInCountry, youtubeId, markContentUnavailable, DATA_ERROR_COPY } from '../../../lib/sanity';
import { article as articleSchema, breadcrumbs } from '../../../lib/schema';
import ResponsibleGaming from '../../../components/ResponsibleGaming.astro';

/**
 * Связка статья → инструмент. Тело статьи живёт в Sanity и ссылку на инструмент
 * туда не вставить без миграции контента, поэтому связь держит шаблон: у слага
 * из этой карты после текста рендерится плашка с приглашением посчитать.
 */
const RELATED_TOOL: Record<string, { segments: string[]; label: Record<Language, string> }> = {
  'football-betting-basics': {
    segments: ['tools', 'odds-converter'],
    label: {
      ru: 'Переведите коэффициенты: конвертер форматов',
      en: 'Convert the odds: format converter',
      es: 'Convierta las cuotas: conversor de formatos',
      pt: 'Converta as odds: conversor de formatos',
      de: 'Quoten umrechnen: Format-Rechner',
      fr: 'Convertissez les cotes : convertisseur de formats',
      br: 'Converta as odds: conversor de formatos',
    },
  },
  'wagering-explained': {
    segments: ['tools', 'wagering-calculator'],
    label: {
      ru: 'Посчитайте свой бонус: калькулятор вейджера',
      en: 'Run your own numbers: wagering calculator',
      es: 'Calcule su bono: calculadora de rollover',
      pt: 'Calcule o seu bónus: calculadora de rollover',
      de: 'Rechnen Sie selbst nach: Umsatz-Rechner',
      fr: 'Faites le calcul : calculateur de wagering',
      br: 'Calcule o seu bônus: calculadora de rollover',
    },
  },
};

const { lang, slug } = Astro.params as { lang: Language; slug: string };

// Подстраховка: в SSR [lang] ловит любой первый сегмент, поэтому без проверки
// /foo/articles/... отдавал бы 200 с русским контентом (soft-404).
if (!isLanguage(lang)) return Astro.rewrite('/404');

const t = useTranslations(lang);
const country = Astro.request.headers.get('cf-ipcountry') ?? '';

const articleResult = await getArticleBySlug(slug, lang);
const article = articleResult.data;

// Отказ CMS — это не отсутствие статьи. 404 здесь был бы враньём: материал
// существует, просто сейчас недоступен, и такой ответ выбил бы живой URL из
// индекса из-за нашего же сбоя. Поэтому 503 с человеческой страницей, а
// `Retry-After` зовёт краулер вернуться позже.
const errorCopy = DATA_ERROR_COPY[lang];
if (articleResult.failed) markContentUnavailable(Astro.response);

// Нет статьи или она закрыта по гео — честный 404, а не редирект на главную:
// редирект Google трактует как soft-404 и держит URL в индексе.
if (!article && !articleResult.failed) return Astro.rewrite('/404');
if (article && isBlockedInCountry(article.blockedIn, country)) return Astro.rewrite('/404');

// Тексты уже сведены к одному языку в GROQ (с фолбэком на русский), поэтому
// страница читает готовые поля, а не выбирает язык из семи вариантов.
const displayTitle = article?.title ?? '';
const displayDescription = article?.description ?? '';
const bodyHtml = article ? renderMarkdown(article.body) : '';

// Флаг приходит из проекции и учитывает и заголовок, и тело: раньше плашку
// решал один заголовок, и статья с переведённым `title_en`, но пустым
// `body_en` отдавала русский текст без всякого предупреждения.
const hasTranslation = article?.hasTranslation ?? true;

const formattedDate = article
  ? new Intl.DateTimeFormat(HTML_LANG[lang], {
      year: 'numeric', month: 'long', day: 'numeric',
    }).format(new Date(article.pubDate))
  : '';

const ytId = article?.youtube ? youtubeId(article.youtube) : null;
const ogImage = article?.imageUrl ? `${article.imageUrl}?w=1200&h=630&fit=crop&auto=format` : undefined;

// Дата правки показывается только если она заметно позже публикации: Sanity
// обновляет `_updatedAt` при любом сохранении, включая правку опечатки через
// минуту после выпуска, и «Обновлено» в тот же день выглядит как шум. Сутки —
// порог, ниже которого читателю эта строка ничего не сообщает.
const updatedAt = article?._updatedAt ? new Date(article._updatedAt) : null;
const publishedAt = article ? new Date(article.pubDate) : null;
const showUpdated =
  updatedAt && publishedAt && updatedAt.getTime() - publishedAt.getTime() > 86_400_000;
const formattedUpdated = showUpdated
  ? new Intl.DateTimeFormat(HTML_LANG[lang], { year: 'numeric', month: 'long', day: 'numeric' }).format(updatedAt)
  : '';

// Разметка собирается из тех же данных, что и видимая страница: крошки
// повторяют `nav.breadcrumb` ниже, а не описывают отдельную выдуманную
// иерархию — расхождение разметки с HTML Google трактует как нарушение.
const sectionName = article?.section
  ? (t.sections[article.section as keyof typeof t.sections] ?? article.section)
  : '';
const canonical = article ? new URL(path(lang, 'articles', article.id), Astro.site) : null;
const authorUrl = article?.authorSlug
  ? new URL(path(lang, 'authors', article.authorSlug), Astro.site).toString()
  : undefined;

const schema = article && canonical
  ? [
      articleSchema(Astro.site!, {
        url: canonical,
        headline: displayTitle,
        description: displayDescription,
        datePublished: article.pubDate,
        dateModified: article._updatedAt,
        authorName: article.author,
        authorUrl,
        imageUrl: article.imageUrl,
        lang,
        section: sectionName || undefined,
      }),
      breadcrumbs([
        { name: t.nav.home, url: new URL(path(lang), Astro.site).toString() },
        ...(article.section
          ? [{ name: sectionName, url: new URL(path(lang, article.section), Astro.site).toString() }]
          : []),
        { name: displayTitle, url: canonical.toString() },
      ]),
    ]
  : [];
---

{article === null ? (
  <BaseLayout
    lang={lang}
    title={errorCopy.title}
    description={errorCopy.body}
    currentPath={`articles/${slug}`}
    noindex
  >
    <header class="page-head">
      <div class="container">
        <h1>{errorCopy.title}</h1>
        <p class="lede">{errorCopy.body}</p>
        <div class="nf-actions">
          <a href={path(lang)} class="btn btn--primary">{t.notFound.backHome}</a>
          <a href={path(lang, 'faq')} class="btn">{t.nav.faq}</a>
        </div>
      </div>
    </header>
  </BaseLayout>
) : (
  <BaseLayout
    lang={lang}
    title={displayTitle}
    description={displayDescription}
    currentPath={`articles/${article.id}`}
    ogImage={ogImage}
    schema={schema}
  >
    {/*
      Обложка больше не растягивается на всю ширину под заголовком: размытая
      подложка спорила с текстом и снижала читаемость на каждой статье.
      Картинка, если редактор её загрузил, стоит внутри колонки чтения как
      обычная иллюстрация — на своём месте и в своём масштабе.
    */}
    <header class="page-head article-head">
      <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href={path(lang)}>{t.nav.home}</a>
          <span class="sep">/</span>
          {article.section && (
            <a href={path(lang, article.section)}>
              {t.sections[article.section as keyof typeof t.sections] ?? article.section}
            </a>
          )}
        </nav>
        <h1>{displayTitle}</h1>
        <p class="lede">{displayDescription}</p>
        <div class="article-meta">
          <span>{formattedDate}</span>
          {showUpdated && <span>{t.article.updatedOn}: {formattedUpdated}</span>}
          <span>
            {t.article.author}:{' '}
            {article.authorSlug
              ? <a class="meta-link" href={path(lang, 'authors', article.authorSlug)}>{article.author}</a>
              : article.author}
          </span>
          <a href={path(lang, 'editorial-policy')} class="meta-link">{t.footer.editorial}</a>
        </div>
      </div>
    </header>

    <article class="section">
      <div class="container">
        <div class="article-body">
          {/*
            Тот же рельс, что на указателе. Читатель, перешедший со списка,
            попадает в знакомую конструкцию — цифра осталась на месте и
            держится при прокрутке, отвечая на вопрос «сколько ещё».
          */}
          <div class="article-rail">
            <span class="idx-min">{article.readingTime}</span>
            <span class="idx-unit">{t.article.readingUnit}</span>
          </div>

          <div class="article-content">
            {!hasTranslation && (
              <p class="notice">{t.article.translationNotice}</p>
            )}

            <div class="prose" set:html={bodyHtml} />

            {article.imageUrl && (
              <figure class="article-figure">
                <img
                  src={`${article.imageUrl}?w=1000&fit=max&auto=format`}
                  alt={displayTitle}
                  loading="lazy"
                />
              </figure>
            )}

            {ytId && (
              <div class="yt-embed">
                <iframe
                  src={`https://www.youtube-nocookie.com/embed/${ytId}`}
                  title="YouTube video"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  loading="lazy"
                ></iframe>
              </div>
            )}

            {RELATED_TOOL[article.id] && (
              <p class="tool-promo">
                <a href={path(lang, ...RELATED_TOOL[article.id].segments)}>
                  {RELATED_TOOL[article.id].label[lang]} →
                </a>
              </p>
            )}

            <ResponsibleGaming lang={lang} />

            <div class="prose-foot">
              {article.section && (
                <a href={path(lang, article.section)} class="back-link">
                  {`← ${t.article.back}: ${t.sections[article.section as keyof typeof t.sections] ?? article.section}`}
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    </article>
  </BaseLayout>
)}
