---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations } from '../../../i18n/ui';
import { LANGUAGES, HTML_LANG, DEFAULT_LANGUAGE, type Language } from '../../../i18n/languages';
import { path } from '../../../i18n/utils';
import { sectionColor, sectionIcon } from '../../../i18n/sectionTheme';
import ArticleArt from '../../../components/ArticleArt.astro';
import { getArticles, getArticleBySlug, renderMarkdown, extractToc } from '../../../lib/sanity';

export async function getStaticPaths() {
  const articles = await getArticles();
  return LANGUAGES.flatMap((lang) =>
    articles.map((article) => ({
      params: { lang, slug: article.id },
      props: { articleId: article.id },
    })),
  );
}

const { lang } = Astro.params as { lang: Language };
const { articleId } = Astro.props as { articleId: string };
const t = useTranslations(lang);

const article = await getArticleBySlug(articleId);
if (!article) return Astro.redirect(path(lang));

const tr = lang !== DEFAULT_LANGUAGE
  ? article.translations?.find((x) => x.lang === lang)
  : undefined;

const displayTitle = tr?.title ?? article.title;
const displayDescription = tr?.description ?? article.description;
const bodyMd = tr?.body ?? article.body ?? '';
const bodyHtml = renderMarkdown(bodyMd);
const tocItems = extractToc(bodyMd).filter((h) => h.depth === 2);

const formattedDate = new Intl.DateTimeFormat(HTML_LANG[lang], {
  year: 'numeric', month: 'long', day: 'numeric',
}).format(new Date(article.pubDate));

const cardColor = sectionColor(article.section);
const icon = article.sectionIcon || sectionIcon(article.section);
---

<BaseLayout
  lang={lang}
  title={displayTitle}
  description={displayDescription}
  currentPath={`articles/${article.id}`}
>
  <div class="reading-progress" aria-hidden="true">
    <div class="reading-progress-bar" id="reading-progress-bar"></div>
  </div>

  <header class="page-head page-head--article" style={`--card-color: ${cardColor}`}>
    <div class="page-head-art">
      <ArticleArt seed={article.id} color={cardColor} icon={icon} />
    </div>
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={path(lang)}>{t.nav.home}</a>
        <span class="sep">/</span>
        {article.section && (
          <a href={path(lang, article.section)}>
            {t.sections[article.section as keyof typeof t.sections] ?? article.sectionTitle}
          </a>
        )}
        <span class="sep">/</span>
        <span>{displayTitle}</span>
      </nav>
      <h1>{displayTitle}</h1>
      <p class="lede">{displayDescription}</p>
      <div class="article-meta" style="margin-top:1rem; border-top:none; padding-top:0;">
        <span>{t.article.publishedOn} {formattedDate}</span>
        <span class="dot">{t.article.author}: {article.author}</span>
        <span class="dot">{article.readingTime} {t.article.readingTime}</span>
      </div>
    </div>
  </header>

  <article class="section">
    <div class="container">
      {lang !== DEFAULT_LANGUAGE && !tr && (
        <p class="notice">{t.article.translationNotice}</p>
      )}

      <div class="article-layout">
        {tocItems.length > 0 && (
          <aside class="toc">
            <div class="toc-inner">
              <p class="toc-title">{t.article.tableOfContents}</p>
              <nav class="toc-list">
                {tocItems.map((heading) => (
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                ))}
              </nav>
            </div>
          </aside>
        )}

        <div>
          <div class="prose" set:html={bodyHtml} />
          <div class="prose-foot">
            {article.section && (
              <a href={path(lang, article.section)} class="back-link">
                ← {t.article.back}: {t.sections[article.section as keyof typeof t.sections] ?? article.sectionTitle}
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  const bar = document.getElementById('reading-progress-bar');
  function updateProgress() {
    if (!bar) return;
    const scrollable = document.documentElement.scrollHeight - window.innerHeight;
    const ratio = scrollable > 0 ? Math.min(Math.max(window.scrollY / scrollable, 0), 1) : 0;
    bar.style.width = `${ratio * 100}%`;
  }
  updateProgress();
  window.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress);
</script>
