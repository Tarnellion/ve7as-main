---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations } from '../../../i18n/ui';
import { HTML_LANG, DEFAULT_LANGUAGE, type Language } from '../../../i18n/languages';
import { path } from '../../../i18n/utils';
import { sectionColor, sectionIcon } from '../../../i18n/sectionTheme';
import ArticleArt from '../../../components/ArticleArt.astro';
import { getArticleBySlug, renderMarkdown, getArticleText, getArticleBody, isBlockedInCountry, youtubeId } from '../../../lib/sanity';

const { lang, slug } = Astro.params as { lang: Language; slug: string };
const t = useTranslations(lang);
const country = Astro.request.headers.get('cf-ipcountry') ?? '';

const article = await getArticleBySlug(slug);
if (!article) return Astro.redirect(path(lang));
if (isBlockedInCountry(article.blockedIn, country)) return Astro.redirect(path(lang));

const displayTitle = getArticleText(article, 'title', lang);
const displayDescription = getArticleText(article, 'description', lang);
const bodyMd = getArticleBody(article, lang);
const bodyHtml = renderMarkdown(bodyMd);

const hasTranslation = lang === DEFAULT_LANGUAGE || Boolean((article as Record<string, unknown>)[`title_${lang}`]);

const formattedDate = new Intl.DateTimeFormat(HTML_LANG[lang], {
  year: 'numeric', month: 'long', day: 'numeric',
}).format(new Date(article.pubDate));

const cardColor = sectionColor(article.section);
const icon = article.sectionIcon || sectionIcon(article.section);
const ytId = article.youtube ? youtubeId(article.youtube) : null;
const ogImage = article.imageUrl ? `${article.imageUrl}?w=1200&h=630&fit=crop&auto=format` : undefined;
---

<BaseLayout
  lang={lang}
  title={displayTitle}
  description={displayDescription}
  currentPath={`articles/${article.id}`}
  ogImage={ogImage}
>
  <div class="reading-progress" aria-hidden="true">
    <div class="reading-progress-bar" id="reading-progress-bar"></div>
  </div>

  <header class="page-head page-head--article" style={`--card-color: ${cardColor}`}>
    <div class="page-head-art">
      {article.imageUrl
        ? <img src={`${article.imageUrl}?w=1400&h=500&fit=crop&auto=format`} alt={displayTitle} loading="eager" width="1400" height="500" class="page-head-photo" />
        : <ArticleArt seed={article.id} color={cardColor} icon={icon} />
      }
    </div>
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={path(lang)}>{t.nav.home}</a>
        <span class="sep">/</span>
        {article.section && (
          <a href={path(lang, article.section)}>
            {t.sections[article.section as keyof typeof t.sections] ?? article.section}
          </a>
        )}
        <span class="sep">/</span>
        <span>{displayTitle}</span>
      </nav>
      <h1>{displayTitle}</h1>
      <p class="lede">{displayDescription}</p>
      <div class="article-meta" style="margin-top:1rem; border-top:none; padding-top:0;">
        <span>{t.article.publishedOn} {formattedDate}</span>
        <span class="dot">{t.article.author}: {article.author}</span>
        <span class="dot">{article.readingTime} {t.article.readingTime}</span>
      </div>
    </div>
  </header>

  <article class="section">
    <div class="container">
      {!hasTranslation && (
        <p class="notice">{t.article.translationNotice}</p>
      )}
      <div class="prose" set:html={bodyHtml} />
      {ytId && (
        <div class="yt-embed">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${ytId}`}
            title="YouTube video"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      )}
      <div class="prose-foot">
        {article.section && (
          <a href={path(lang, article.section)} class="back-link">
            ← {t.article.back}: {t.sections[article.section as keyof typeof t.sections] ?? article.section}
          </a>
        )}
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  const bar = document.getElementById('reading-progress-bar');
  function updateProgress() {
    if (!bar) return;
    const scrollable = document.documentElement.scrollHeight - window.innerHeight;
    const ratio = scrollable > 0 ? Math.min(Math.max(window.scrollY / scrollable, 0), 1) : 0;
    bar.style.width = `${ratio * 100}%`;
  }
  updateProgress();
  window.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress);
</script>
