---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/ui';
import { languagePaths } from '../../i18n/utils';
import { DEFAULT_LANGUAGE, type Language } from '../../i18n/languages';
import { getFaqItems, renderMarkdown } from '../../lib/sanity';

export function getStaticPaths() {
  return languagePaths();
}

const { lang } = Astro.params as { lang: Language };
const t = useTranslations(lang);

const faqItems = await getFaqItems();
const views = faqItems.map((item) => {
  const tr = lang !== DEFAULT_LANGUAGE
    ? item.translations?.find((x) => x.lang === lang)
    : undefined;
  return {
    question: tr?.question ?? item.question,
    answerHtml: renderMarkdown(tr?.answer ?? item.answer ?? ''),
    hasTranslation: Boolean(tr),
  };
});

const missingTranslation = lang !== DEFAULT_LANGUAGE && views.some((v) => !v.hasTranslation);
---

<BaseLayout lang={lang} title={t.home.faqTitle} description={t.home.faqSubtitle} currentPath="faq">
  <header class="page-head">
    <div class="container">
      <h1>{t.home.faqTitle}</h1>
      <p class="lede">{t.home.faqSubtitle}</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      {missingTranslation && <p class="notice">{t.article.translationNotice}</p>}

      <div class="faq-list">
        {views.map(({ question, answerHtml }, i) => (
          <details class="faq-item" open={i === 0}>
            <summary>{question}</summary>
            <div class="faq-body prose" set:html={answerHtml} />
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
