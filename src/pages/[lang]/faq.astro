---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/ui';
import { isLanguage, type Language } from '../../i18n/languages';
import { getFaqItems, renderMarkdown, isBlockedInCountry, markContentUnavailable, DATA_ERROR_COPY } from '../../lib/sanity';
import { faqPage } from '../../lib/schema';

const { lang } = Astro.params as { lang: Language };

// Подстраховка: в SSR [lang] ловит любой первый сегмент, поэтому без проверки
// /foo/faq/ отдавал бы 200 с русским контентом (soft-404).
if (!isLanguage(lang)) return Astro.rewrite('/404');

const t = useTranslations(lang);

/**
 * Meta-description страницы. Подпись блока FAQ с главной (t.home.faqSubtitle)
 * для сниппета слишком короткая (38–45 симв. против нормы 70–160), а удлинять
 * её нельзя — она стоит и под заголовком секции на главной.
 */
const FAQ_META_DESCRIPTION: Record<Language, string> = {
  ru: 'Ответы на частые вопросы о Ve7as: кто мы, почему без рекламы и рейтингов казино, откуда берём факты и как устроены наши материалы.',
  en: 'Answers to common questions about Ve7as: who we are, why there are no casino ads or rankings, where our facts come from and how our articles are made.',
  es: 'Respuestas a preguntas frecuentes sobre Ve7as: quiénes somos, por qué no hay publicidad ni rankings de casinos y de dónde salen nuestros datos.',
  pt: 'Respostas às perguntas frequentes sobre o Ve7as: quem somos, porque não há publicidade nem rankings de casinos e de onde vêm os nossos factos.',
  de: 'Antworten auf häufige Fragen zu Ve7as: wer wir sind, warum es keine Casino-Werbung und keine Rankings gibt und woher unsere Fakten stammen.',
  fr: 'Réponses aux questions fréquentes sur Ve7as : qui nous sommes, pourquoi ni publicité ni classements de casinos, et d’où viennent nos informations.',
  br: 'Respostas às perguntas frequentes sobre o Ve7as: quem somos, por que não há publicidade nem rankings de cassinos e de onde vêm os nossos fatos.',
};
const country = Astro.request.headers.get('cf-ipcountry') ?? '';

const faqResult = await getFaqItems(lang);
const faqItems = faqResult.data.filter((f) => !isBlockedInCountry(f.blockedIn, country));

// Сбой CMS оставляет страницу живой (шапка, навигация, футер), но список
// вопросов — это и есть страница, поэтому статус 503, а не 200 с пустотой.
const errorCopy = DATA_ERROR_COPY[lang];
if (faqResult.failed) markContentUnavailable(Astro.response);

// Тексты и признак перевода приходят из GROQ; флаг учитывает и вопрос, и ответ.
const views = faqItems.map((item) => ({
  question: item.question,
  answerHtml: renderMarkdown(item.answer),
  hasTranslation: item.hasTranslation,
}));

const missingTranslation = views.some((v) => !v.hasTranslation);

// Разметка строится из `views` — того же массива, что отрисовывается ниже,
// уже после гео-фильтра. HTML в ответах допустим: Google принимает в
// `Answer.text` ограниченный набор тегов, и это ровно тот HTML, что видит
// читатель. Пустой FAQ (сбой CMS) разметку не порождает вовсе.
const schema = views.length > 0
  ? [faqPage(views.map((v) => ({ question: v.question, answer: v.answerHtml })))]
  : [];
---

<BaseLayout lang={lang} title={t.home.faqTitle} description={FAQ_META_DESCRIPTION[lang]} currentPath="faq" schema={schema}>
  <header class="page-head">
    <div class="container">
      <h1>{t.home.faqTitle}</h1>
      <p class="lede">{t.home.faqSubtitle}</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      {faqResult.failed && (
        <p class="notice notice--error">
          <strong>{errorCopy.title}.</strong> {errorCopy.body}
        </p>
      )}

      {missingTranslation && <p class="notice">{t.article.translationNotice}</p>}

      <div class="faq-list">
        {views.map(({ question, answerHtml }, i) => (
          <details class="faq-item" open={i === 0}>
            <summary>{question}</summary>
            <div class="faq-body prose" set:html={answerHtml} />
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
