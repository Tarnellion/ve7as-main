---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/ui';
import { DEFAULT_LANGUAGE, type Language } from '../../i18n/languages';
import { getFaqItems, renderMarkdown, getFaqText, isBlockedInCountry } from '../../lib/sanity';

const { lang } = Astro.params as { lang: Language };
const t = useTranslations(lang);
const country = Astro.request.headers.get('cf-ipcountry') ?? '';

const allFaq = await getFaqItems();
const faqItems = allFaq.filter((f) => !isBlockedInCountry(f.blockedIn, country));

const views = faqItems.map((item) => ({
  question: getFaqText(item, 'question', lang),
  answerHtml: renderMarkdown(getFaqText(item, 'answer', lang)),
  hasTranslation: lang === DEFAULT_LANGUAGE || Boolean((item as Record<string, unknown>)[`question_${lang}`]),
}));

const missingTranslation = views.some((v) => !v.hasTranslation);
---

<BaseLayout lang={lang} title={t.home.faqTitle} description={t.home.faqSubtitle} currentPath="faq">
  <header class="page-head">
    <div class="container">
      <h1>{t.home.faqTitle}</h1>
      <p class="lede">{t.home.faqSubtitle}</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      {missingTranslation && <p class="notice">{t.article.translationNotice}</p>}

      <div class="faq-list">
        {views.map(({ question, answerHtml }, i) => (
          <details class="faq-item" open={i === 0}>
            <summary>{question}</summary>
            <div class="faq-body prose" set:html={answerHtml} />
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
