---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/ui';
import { languagePaths } from '../../i18n/utils';
import { DEFAULT_LANGUAGE, type Language } from '../../i18n/languages';

export function getStaticPaths() {
  return languagePaths();
}

const { lang } = Astro.params as { lang: Language };
const t = useTranslations(lang);

const faqEntries = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);
const views = await Promise.all(
  faqEntries.map(async (entry) => {
    const translation = lang !== DEFAULT_LANGUAGE
      ? await getEntry('faqTranslations', `${lang}/${entry.id}`)
      : undefined;
    const { Content } = await render(translation ?? entry);
    return {
      question: translation?.data.question ?? entry.data.question,
      hasTranslation: Boolean(translation),
      Content,
    };
  }),
);
const missingTranslation = lang !== DEFAULT_LANGUAGE && views.some((view) => !view.hasTranslation);
---

<BaseLayout lang={lang} title={t.home.faqTitle} description={t.home.faqSubtitle} currentPath="faq">
  <header class="page-head">
    <div class="container">
      <h1>{t.home.faqTitle}</h1>
      <p class="lede">{t.home.faqSubtitle}</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      {missingTranslation && <p class="notice">{t.article.translationNotice}</p>}

      <div class="faq-list">
        {views.map(({ question, Content }, i) => (
          <details class="faq-item" open={i === 0}>
            <summary>{question}</summary>
            <div class="faq-body"><Content /></div>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
