---
import { LANGUAGES, HTML_LANG, type Language } from '../i18n/languages';
import { useTranslations } from '../i18n/ui';
import { path } from '../i18n/utils';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  lang: Language;
  title: string;
  description: string;
  currentPath?: string;
  ogImage?: string;
  /** Держать страницу вне индекса (404 и прочие служебные). */
  noindex?: boolean;
}

const { lang, title, description, currentPath = '', ogImage, noindex = false } = Astro.props;
const t = useTranslations(lang);

// Canonical всегда со слешем на конце: иначе /ru/faq и /ru/faq/ получают
// каждый свой self-canonical и закрепляют дубль вместо того, чтобы схлопнуть его.
const canonicalPath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalURL = new URL(canonicalPath, Astro.site);
const pageTitle = currentPath ? `${title} — Ve7as` : `Ve7as — ${title}`;

/**
 * Сериализация для `<script type="application/ld+json">`.
 *
 * `JSON.stringify` не экранирует `<`, поэтому подстрока `</script>` в любом
 * поле (скажем, в заголовке статьи из CMS) закрывает тег раньше времени, и всё
 * последующее браузер разбирает уже как разметку. Выход из `<script>` всегда
 * начинается с `<` (`</script`, `<!--`), поэтому экранируем именно его:
 * \u003c — валидный JSON-escape, парсер JSON-LD прочитает обычный `<`.
 */
function jsonLd(data: unknown): string {
  return JSON.stringify(data).replace(/</g, '\\u003c');
}
---

<!DOCTYPE html>
<html lang={HTML_LANG[lang]}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
  <link rel="canonical" href={canonicalURL} />

  {LANGUAGES.map((code) => (
    <link rel="alternate" hreflang={HTML_LANG[code]} href={new URL(path(code, currentPath), Astro.site)} />
  ))}
  <link rel="alternate" hreflang="x-default" href={new URL(path('ru', currentPath), Astro.site)} />

  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  {ogImage && <meta name="twitter:card" content="summary_large_image" />}
  {ogImage && <meta name="twitter:image" content={ogImage} />}

  <title>{pageTitle}</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  {/*
    Google Fonts убраны намеренно. Playfair Display рисовался для крупных
    заголовков, а стоял в том числе на мелком тексте; тянулся он с внешнего
    домена блокирующим запросом, и для читателей из ЕС это ещё и передача IP
    третьей стороне. Текст набирается системной антиквой (Charter → Georgia),
    метки — системным гротеском. Ноль сетевых запросов за шрифтами.
  */}

  <script type="application/ld+json" is:inline set:html={jsonLd({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Ve7as',
    url: Astro.site?.toString(),
    description: t.site.tagline,
    publisher: { '@type': 'Organization', name: 'Ve7as' },
    inLanguage: HTML_LANG[lang],
  })} />
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <Header lang={lang} currentPath={currentPath} />
  <main id="main">
    <slot />
  </main>
  <Footer lang={lang} />
</body>
</html>
