---
import { INDEXED_LANGUAGES, HTML_LANG, PRIMARY_LANGUAGE, isIndexable, type Language } from '../i18n/languages';
import { useTranslations } from '../i18n/ui';
import { path } from '../i18n/utils';
import { organization, website, type SchemaNode } from '../lib/schema';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  lang: Language;
  title: string;
  description: string;
  currentPath?: string;
  ogImage?: string;
  /** `article` передаёт только страница статьи; всё остальное — `website`. */
  ogType?: 'website' | 'article';
  /** ISO-даты для `article:*_time`; выводятся только при `ogType="article"`. */
  publishedTime?: string;
  modifiedTime?: string;
  /** Держать страницу вне индекса (404 и прочие служебные). */
  noindex?: boolean;
  /**
   * Узлы JSON-LD, специфичные для страницы: `Article`, `BreadcrumbList`,
   * `FAQPage`. Организация и сайт добавляются сюда сами и повторять их в
   * странице не нужно.
   */
  schema?: SchemaNode[];
  /**
   * Локали, в которых у ЭТОЙ страницы реально есть версия. По умолчанию —
   * все индексируемые: верно для статики, инструментов и списков, которые
   * существуют на каждом языке. Страница статьи передаёт сюда только локали
   * с переводом: hreflang на версию-фолбэк — это тег на noindex-страницу,
   * противоречие, из-за которого Google отбрасывает кластер целиком.
   */
  alternates?: Language[];
}

const props = Astro.props;

// Страница вне индексируемых локалей закрывается независимо от собственного
// флага: `noindex` из пропсов — про служебные страницы, а этот — про решение
// уровня сайта (см. INDEXED_LANGUAGES). Ссылки остаются follow, чтобы вес
// проходил на индексируемые версии.
const {
  lang,
  title,
  description,
  currentPath = '',
  ogImage,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  schema = [],
} = props;
const noindex = (props.noindex ?? false) || !isIndexable(lang);

// Один hreflang без пары бессмыслен: если у страницы нет ни одной живой
// альтернативы, кластер не объявляется вовсе (self-canonical достаточно).
const alternateLangs = (props.alternates ?? [...INDEXED_LANGUAGES]).filter(isIndexable);
const emitHreflang = !noindex && alternateLangs.length >= 2;
const emitXDefault = emitHreflang && alternateLangs.includes(PRIMARY_LANGUAGE);
const t = useTranslations(lang);

// Canonical всегда со слешем на конце: иначе /ru/faq и /ru/faq/ получают
// каждый свой self-canonical и закрепляют дубль вместо того, чтобы схлопнуть его.
const canonicalPath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalURL = new URL(canonicalPath, Astro.site);

// Суффикс бренда ставится, только пока заголовок с ним умещается в 60 знаков —
// длиннее выдача обрезает. Не возвращать безусловный суффикс: 71 из 113
// заголовков статей выходили за 60 только из-за него.
const SUFFIX = ' — Ve7as';
const pageTitle = !currentPath
  ? `Ve7as — ${title}`
  : (title.length + SUFFIX.length > 60 ? title : title + SUFFIX);

// `og:locale` в формате language_TERRITORY. `br` — бразильский португальский,
// поэтому pt_BR, а не код из адреса.
const OG_LOCALE: Record<Language, string> = { ru: 'ru_RU', en: 'en_US', es: 'es_ES', pt: 'pt_PT', de: 'de_DE', fr: 'fr_FR', br: 'pt_BR' };

// Общая карточка — только для не-статей. У статьи без своей обложки картинки
// нет вовсе: Google просит не ставить в `og:image` статьи обезличенную
// заглушку, и в `Article.image` она тоже не попадает (схему собирает страница
// из собственной обложки, а не из этого значения).
const shareImage = ogImage ?? (ogType === 'article' ? undefined : new URL('/og/default.png', Astro.site).toString());

/**
 * Сериализация для `<script type="application/ld+json">`.
 *
 * `JSON.stringify` не экранирует `<`, поэтому подстрока `</script>` в любом
 * поле (скажем, в заголовке статьи из CMS) закрывает тег раньше времени, и всё
 * последующее браузер разбирает уже как разметку. Выход из `<script>` всегда
 * начинается с `<` (`</script`, `<!--`), поэтому экранируем именно его:
 * \u003c — валидный JSON-escape, парсер JSON-LD прочитает обычный `<`.
 */
function jsonLd(data: unknown): string {
  return JSON.stringify(data).replace(/</g, '\\u003c');
}

/**
 * Один `@graph` на страницу вместо нескольких независимых блоков: так
 * `Article.publisher` и `WebSite.publisher` указывают на один и тот же узел
 * организации по `@id`, а не плодят три её несвязанные копии.
 */
const graph = [
  organization(Astro.site!, t.site.tagline),
  website(Astro.site!, lang, t.site.tagline),
  ...schema,
];
---

<!DOCTYPE html>
<html lang={HTML_LANG[lang]}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
  <link rel="canonical" href={canonicalURL} />

  {/*
    hreflang объявляет только индексируемые локали: тег на noindex-версию —
    противоречие (страница одновременно «альтернатива» и «не индексируй»),
    которое Google разрешает отбрасыванием всего кластера. На самих
    noindex-страницах hreflang не выводится вовсе — их в кластере нет.
  */}
  {emitHreflang && alternateLangs.map((code) => (
    <link rel="alternate" hreflang={HTML_LANG[code]} href={new URL(path(code, currentPath), Astro.site)} />
  ))}
  {emitXDefault && <link rel="alternate" hreflang="x-default" href={new URL(path(PRIMARY_LANGUAGE, currentPath), Astro.site)} />}

  {/*
    Фид локали. Это второй канал обнаружения новых материалов после sitemap и
    единственный, на который можно подписаться: конвейер публикует без
    деплоя, а sitemap на домене без внешних ссылок перечитывается редко.
    Объявляется только у индексируемых локалей — у остальных фида нет
    (см. `src/pages/[lang]/rss.xml.ts`).
  */}
  {isIndexable(lang) && (
    <link rel="alternate" type="application/rss+xml" title="Ve7as" href={new URL(`${path(lang)}rss.xml`, Astro.site)} />
  )}

  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Ve7as" />
  <meta property="og:locale" content={OG_LOCALE[lang]} />
  <meta property="og:url" content={canonicalURL} />
  {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
  {shareImage && <meta property="og:image" content={shareImage} />}
  {shareImage && <meta property="og:image:width" content="1200" />}
  {shareImage && <meta property="og:image:height" content="630" />}
  <meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
  {shareImage && <meta name="twitter:image" content={shareImage} />}

  <title>{pageTitle}</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  {/*
    Google Fonts убраны намеренно. Playfair Display рисовался для крупных
    заголовков, а стоял в том числе на мелком тексте; тянулся он с внешнего
    домена блокирующим запросом, и для читателей из ЕС это ещё и передача IP
    третьей стороне. Текст набирается системной антиквой (Charter → Georgia),
    метки — системным гротеском. Ноль сетевых запросов за шрифтами.
  */}

  <script type="application/ld+json" is:inline set:html={jsonLd({
    '@context': 'https://schema.org',
    '@graph': graph,
  })} />
</head>
<body>
  <a href="#main" class="skip-link">{t.nav.skip}</a>
  <Header lang={lang} currentPath={currentPath} />
  <main id="main">
    <slot />
  </main>
  <Footer lang={lang} />
</body>
</html>
