---
import { HTML_LANG, type Language } from '../i18n/languages';
import { useTranslations } from '../i18n/ui';
import { path } from '../i18n/utils';
import { type SanityArticleCard } from '../lib/sanity';

interface Props {
  lang: Language;
  article: SanityArticleCard;
}

const { lang, article } = Astro.props;
const t = useTranslations(lang);
// Язык выбран ещё в GROQ-проекции (с фолбэком на русский), строке индекса
// остаётся только вывести готовые значения.
const { section, pubDate, readingTime, title, description } = article;

const formattedDate = new Intl.DateTimeFormat(HTML_LANG[lang], {
  year: 'numeric', month: 'long', day: 'numeric',
}).format(new Date(pubDate));
---

{/*
  Строка указателя. Одна и та же на главной и в архиве раздела: обе страницы —
  списки статей, и разводить их в разные компоненты значило бы поддерживать
  два вида одного и того же.

  Время чтения слева крупной цифрой — это выбор читателя объясняющего портала:
  он решает не «что красивее», а «на сколько я готов вникнуть».
*/}
<a href={path(lang, 'articles', article.id)} class="idx-row">
  <span class="idx-time">
    <span class="idx-min">{readingTime}</span>
    <span class="idx-unit">{t.article.readingUnit}</span>
  </span>
  <span class="idx-body">
    <span class="idx-sect">{t.sections[section as keyof typeof t.sections] ?? section}</span>
    <span class="idx-title">{title}</span>
    <span class="idx-desc">{description}</span>
    <span class="idx-date">{formattedDate}</span>
  </span>
</a>
