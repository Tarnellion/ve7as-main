---
interface Props {
  /** Deterministic seed (e.g. article id or section id) — same seed always renders the same art. */
  seed: string;
  /** Theme color (hex) used to tint the generated composition. */
  color: string;
  /** Optional glyph (emoji) drawn large and faint as a focal accent. */
  icon?: string;
}

const { seed, color, icon } = Astro.props;

function hashSeed(value: string): number {
  let h = 2166136261;
  for (let i = 0; i < value.length; i++) {
    h ^= value.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

function mulberry32(seed: number) {
  let t = seed;
  return () => {
    t = (t + 0x6d2b79f5) | 0;
    let r = Math.imul(t ^ (t >>> 15), 1 | t);
    r = (r + Math.imul(r ^ (r >>> 7), 61 | r)) ^ r;
    return ((r ^ (r >>> 14)) >>> 0) / 4294967296;
  };
}

const hash = hashSeed(seed);
const rand = mulberry32(hash);
const uid = `art-${hash.toString(36)}`;

const blobs = Array.from({ length: 3 }, () => ({
  cx: 16 + rand() * 68,
  cy: 14 + rand() * 72,
  r: 22 + rand() * 30,
  opacity: 0.1 + rand() * 0.16,
}));

const ringCx = 14 + rand() * 72;
const ringCy = 14 + rand() * 72;
const ringR = 16 + rand() * 22;

const tilt = Math.round(-16 + rand() * 32);
const iconX = 28 + rand() * 44;
const iconY = 36 + rand() * 40;
---

<svg viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice" class="article-art" role="presentation" aria-hidden="true">
  <defs>
    <linearGradient id={`${uid}-bg`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color={color} stop-opacity="0.4" />
      <stop offset="55%" stop-color={color} stop-opacity="0.12" />
      <stop offset="100%" stop-color={color} stop-opacity="0.02" />
    </linearGradient>
    <pattern id={`${uid}-dots`} width="9" height="9" patternUnits="userSpaceOnUse">
      <circle cx="1.2" cy="1.2" r="1.1" fill={color} opacity="0.16" />
    </pattern>
  </defs>

  <rect width="100" height="100" fill={`url(#${uid}-bg)`} />
  <rect width="100" height="100" fill={`url(#${uid}-dots)`} />

  {blobs.map((b) => (
    <circle cx={b.cx} cy={b.cy} r={b.r} fill={color} opacity={b.opacity} />
  ))}

  <circle cx={ringCx} cy={ringCy} r={ringR} fill="none" stroke={color} stroke-width="1.4" opacity="0.35" />
  <circle cx={ringCx} cy={ringCy} r={ringR * 0.56} fill="none" stroke={color} stroke-width="0.8" opacity="0.22" />

  {icon && (
    <text
      x={iconX}
      y={iconY}
      font-size="34"
      text-anchor="middle"
      dominant-baseline="central"
      opacity="0.5"
      transform={`rotate(${tilt} ${iconX} ${iconY})`}
    >{icon}</text>
  )}
</svg>

<style>
  .article-art {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
